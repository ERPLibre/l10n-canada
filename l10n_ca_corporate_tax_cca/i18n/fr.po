#. module: l10n_ca_corporate_tax_cca
#. odoo-python
#: code:addons/l10n_ca_corporate_tax_cca/models/l10n_ca_corporate_tax_estimate.py:0
msgid "Book gain on disposal of assets reversed (line 401)"
msgstr ""
"Gain comptable sur la disposition d'immobilisations annulé (ligne 401)"

#. module: l10n_ca_corporate_tax_cca
#. odoo-python
#: code:addons/l10n_ca_corporate_tax_cca/models/l10n_ca_corporate_tax_estimate.py:0
