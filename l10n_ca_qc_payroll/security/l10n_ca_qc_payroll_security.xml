        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="l10n_ca_qc_rl1_slip_rule_company" model="ir.rule">
        <field name="name">RL-1 Slip: multi-company</field>
        <field name="model_id" ref="model_l10n_ca_qc_rl1_slip" />
        <field name="global" eval="True" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="l10n_ca_qc_payroll_remittance_rule_company" model="ir.rule">
        <field name="name">Revenu Quebec Remittance: multi-company</field>
        <field name="model_id" ref="model_l10n_ca_qc_payroll_remittance" />
        <field name="global" eval="True" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
