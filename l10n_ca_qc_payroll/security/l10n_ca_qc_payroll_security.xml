<odoo noupdate="1">
    <record id="l10n_ca_qc_rl1_summary_rule_company" model="ir.rule">
        <field name="name">RL-1 Summary: multi-company</field>
        <field name="model_id" ref="model_l10n_ca_qc_rl1_summary" />
