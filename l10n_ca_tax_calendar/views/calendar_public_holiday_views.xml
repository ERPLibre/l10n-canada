<odoo>
    <record id="view_calendar_public_holiday_form" model="ir.ui.view">
        <field name="name">calendar.public.holiday.form.l10n_ca_tax_calendar</field>
        <field name="model">calendar.public.holiday</field>
        <field
            name="inherit_id"
            ref="calendar_public_holiday.view_calendar_public_holiday_form"
        />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='line_ids']/list/field[@name='variable_date']" position="after">
                <field name="l10n_ca_jurisdiction" />
            </xpath>
        </field>
    </record>

    <record id="action_l10n_ca_public_holiday" model="ir.actions.act_window">
        <field name="name">Public Holidays</field>
        <field name="res_model">calendar.public.holiday</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('country_id.code', 'in', ('CA', False))]</field>
        <field name="context" eval="{'default_country_id': ref('base.ca')}" />
    </record>
</odoo>
