<odoo>
    <record id="l10n_ca_tax_deadline_view_list" model="ir.ui.view">
        <field name="name">l10n.ca.tax.deadline.list</field>
        <field name="model">l10n.ca.tax.deadline</field>
        <field name="arch" type="xml">
            <list
                decoration-danger="is_overdue"
                decoration-muted="state == 'cancel'"
                decoration-success="state == 'done'"
                sample="1"
            >
                <field name="due_date" />
                <field name="name" />
                <field name="authority" />
                <field name="category" optional="hide" />
                <field name="period_end" optional="show" />
                <field name="user_id" widget="many2one_avatar_user" optional="show" />
                <field name="days_left" optional="show" />
                <field name="company_id" groups="base.group_multi_company" />
                <field name="is_overdue" column_invisible="True" />
                <field name="activity_ids" widget="list_activity" optional="show" />
                <field
                    name="state"
                    widget="badge"
                    decoration-info="state == 'todo'"
                    decoration-success="state == 'done'"
                />
                <button
                    name="action_done"
                    type="object"
                    string="Done"
                    icon="fa-check"
                    invisible="state != 'todo'"
                />
            </list>
        </field>
    </record>

    <record id="l10n_ca_tax_deadline_view_form" model="ir.ui.view">
        <field name="name">l10n.ca.tax.deadline.form</field>
        <field name="model">l10n.ca.tax.deadline</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_done"
                        type="object"
                        string="Mark as Done"
                        class="oe_highlight"
                        invisible="state != 'todo'"
                    />
                    <button
                        name="action_cancel"
                        type="object"
                        string="Cancel"
                        invisible="state != 'todo'"
                    />
                    <button
                        name="action_reset_todo"
                        type="object"
                        string="Reset to To Do"
                        invisible="state == 'todo'"
                    />
                    <field name="state" widget="statusbar" statusbar_visible="todo,done" />
                </header>
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Overdue"
                        bg_color="text-bg-danger"
                        invisible="not is_overdue"
                    />
                    <div class="oe_title">
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="rule_id" />
                            <field name="authority" />
                            <field name="category" />
                            <field name="period_start" />
                            <field name="period_end" />
                        </group>
                        <group>
                            <field name="due_date" />
                            <field name="days_left" invisible="state != 'todo'" />
                            <field name="user_id" widget="many2one_avatar_user" />
                            <field name="done_date" invisible="state != 'done'" />
                            <field name="reference" />
                            <field name="company_id" groups="base.group_multi_company" />
                            <field name="is_overdue" invisible="1" />
                        </group>
                    </group>
                    <separator string="Legal Rule" />
                    <div>
                        <field name="rule_description" />
                    </div>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="l10n_ca_tax_deadline_view_calendar" model="ir.ui.view">
        <field name="name">l10n.ca.tax.deadline.calendar</field>
        <field name="model">l10n.ca.tax.deadline</field>
        <field name="arch" type="xml">
            <calendar
                date_start="due_date"
                color="authority"
                mode="month"
                quick_create="0"
                event_open_popup="1"
            >
                <field name="name" />
                <field name="state" />
                <field name="user_id" />
            </calendar>
        </field>
    </record>

    <record id="l10n_ca_tax_deadline_view_kanban" model="ir.ui.view">
        <field name="name">l10n.ca.tax.deadline.kanban</field>
        <field name="model">l10n.ca.tax.deadline</field>
        <field name="arch" type="xml">
            <kanban
                default_group_by="state"
                group_create="0"
                quick_create="0"
                highlight_color="color"
                sample="1"
            >
                <field name="color" />
                <field name="is_overdue" />
                <templates>
                    <t t-name="card">
                        <field name="name" class="fw-bold" />
                        <div class="d-flex">
                            <field name="authority" class="text-muted" />
                        </div>
                        <footer>
                            <field name="due_date" />
                            <field name="activity_ids" widget="kanban_activity" />
                            <field
                                name="user_id"
                                widget="many2one_avatar_user"
                                class="ms-auto"
                            />
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="l10n_ca_tax_deadline_view_search" model="ir.ui.view">
        <field name="name">l10n.ca.tax.deadline.search</field>
        <field name="model">l10n.ca.tax.deadline</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="rule_id" />
                <field name="user_id" />
                <filter name="todo" string="To Do" domain="[('state', '=', 'todo')]" />
                <filter name="overdue" string="Overdue" domain="[('is_overdue', '=', True)]" />
                <filter
                    name="next_30_days"
                    string="Due in 30 Days"
                    domain="[('state', '=', 'todo'), ('due_date', '&lt;=', (context_today() + relativedelta(days=30)).strftime('%Y-%m-%d'))]"
                />
                <filter name="my" string="My Deadlines" domain="[('user_id', '=', uid)]" />
                <separator />
                <filter name="cra" string="CRA" domain="[('authority', '=', 'cra')]" />
                <filter name="rq" string="Revenu Quebec" domain="[('authority', '=', 'rq')]" />
                <filter
                    name="other_authorities"
                    string="Registraire and CNESST"
                    domain="[('authority', 'in', ('req', 'cnesst'))]"
                />
                <separator />
                <filter name="filter_due_date" string="Due Date" date="due_date" />
                <group>
                    <filter name="group_authority" string="Authority" context="{'group_by': 'authority'}" />
                    <filter name="group_category" string="Category" context="{'group_by': 'category'}" />
                    <filter name="group_month" string="Due Month" context="{'group_by': 'due_date:month'}" />
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="action_l10n_ca_tax_deadline" model="ir.actions.act_window">
        <field name="name">Tax Deadlines</field>
        <field name="res_model">l10n.ca.tax.deadline</field>
        <field name="view_mode">list,calendar,kanban,form</field>
        <field name="context">{'search_default_todo': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No tax deadline yet.</p>
            <p>
                Set the Canadian tax profile of the company in the accounting
                settings, then run <em>Generate Deadlines</em>: the deadlines due in
                the coming months appear here, and a reminder activity is
                scheduled before each due date.
            </p>
        </field>
    </record>

    <record id="action_l10n_ca_tax_deadline_generate" model="ir.actions.server">
        <field name="name">Generate Deadlines</field>
        <field name="model_id" ref="model_l10n_ca_tax_deadline" />
        <field name="state">code</field>
        <field name="code">action = model.action_generate_now()</field>
    </record>
</odoo>
