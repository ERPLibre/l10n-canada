<odoo>
    <record id="l10n_ca_tax_deadline_rule_view_list" model="ir.ui.view">
        <field name="name">l10n.ca.tax.deadline.rule.list</field>
        <field name="model">l10n.ca.tax.deadline.rule</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="code" optional="hide" />
                <field name="authority" />
                <field name="category" />
                <field name="period_type" />
                <field name="due_date_shift" optional="show" />
                <field name="user_id" optional="hide" />
                <field name="active" column_invisible="True" />
            </list>
        </field>
    </record>

    <record id="l10n_ca_tax_deadline_rule_view_form" model="ir.ui.view">
        <field name="name">l10n.ca.tax.deadline.rule.form</field>
        <field name="model">l10n.ca.tax.deadline.rule</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_view_deadlines"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-calendar"
                            string="Deadlines"
                        />
                    </div>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="text-bg-danger"
                        invisible="active"
                    />
                    <div class="oe_title">
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <group>
                        <group string="Rule">
                            <field name="code" />
                            <field name="authority" />
                            <field name="category" />
                            <field name="user_id" />
                            <field name="active" invisible="1" />
                        </group>
                        <group string="Due Date">
                            <field name="period_type" />
                            <field name="timing_param_code" />
                            <field name="current_timing" invisible="not timing_param_code" />
                            <field name="offset_months" invisible="timing_param_code or fixed_month" />
                            <field name="offset_days" invisible="timing_param_code or fixed_month" />
                            <field
                                name="offset_business_days"
                                invisible="timing_param_code or fixed_month"
                            />
                            <field name="fixed_month" invisible="timing_param_code" />
                            <field name="fixed_day" invisible="timing_param_code or not fixed_month" />
                            <field
                                name="fixed_year_offset"
                                invisible="timing_param_code or not fixed_month"
                            />
                            <field name="due_date_shift" />
                            <field name="holiday_jurisdiction" />
                        </group>
                    </group>
                    <group string="Applies When">
                        <field
                            name="condition_domain"
                            widget="domain"
                            options="{'model': 'res.company', 'in_dialog': True}"
                            nolabel="1"
                            colspan="2"
                        />
                    </group>
                    <separator string="Legal Rule and Sources" />
                    <field name="description" nolabel="1" />
                </sheet>
            </form>
        </field>
    </record>

    <record id="l10n_ca_tax_deadline_rule_view_search" model="ir.ui.view">
        <field name="name">l10n.ca.tax.deadline.rule.search</field>
        <field name="model">l10n.ca.tax.deadline.rule</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="code" />
                <filter name="archived" string="Archived" domain="[('active', '=', False)]" />
                <group>
                    <filter name="group_authority" string="Authority" context="{'group_by': 'authority'}" />
                    <filter name="group_category" string="Category" context="{'group_by': 'category'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="action_l10n_ca_tax_deadline_rule" model="ir.actions.act_window">
        <field name="name">Tax Deadline Rules</field>
        <field name="res_model">l10n.ca.tax.deadline.rule</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
