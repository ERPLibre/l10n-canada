<odoo>
    <record id="hr_contract_view_form" model="ir.ui.view">
        <field name="name">hr.contract.form.l10n_ca_on_payroll</field>
        <field name="model">hr.contract</field>
        <field name="inherit_id" ref="l10n_ca_payroll.hr_contract_view_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//group[@name='l10n_ca_td1_provincial']"
                position="inside"
            >
                <field
                    name="l10n_ca_on_dependants_under_19"
                    invisible="l10n_ca_province_code != 'ON'"
                />
                <field
                    name="l10n_ca_on_disabled_dependants"
                    invisible="l10n_ca_province_code != 'ON'"
                />
            </xpath>
        </field>
    </record>
</odoo>
