#: model:l10n_ca.payroll.source,summary:l10n_ca_on_payroll.source_wsia
msgid ""
"Maximum insurable earnings of 175% of the average industrial wage, premiums "
"only up to that maximum, employer rate and payment schedule set by the "
"annual notice of the WSIB."
msgstr ""

#. module: l10n_ca_on_payroll
#: model:ir.model.fields,help:l10n_ca_on_payroll.field_hr_contract__l10n_ca_on_dependants_under_19
