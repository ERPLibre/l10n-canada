#. module: l10n_ca_on_payroll
#: model:ir.model.fields.selection,name:l10n_ca_on_payroll.selection__hr_contract__l10n_ca_on_td1_type__exempt
msgid "Exempt (claim code E)"
msgstr "Exempté (code de demande E)"

#. module: l10n_ca_on_payroll
#: model_terms:ir.ui.view,arch_db:l10n_ca_on_payroll.res_config_settings_view_form
msgid "Exemption and annual total Ontario remuneration that sets the EHT rate"
msgstr ""
"Exonération et rémunération totale annuelle en Ontario qui fixe le taux de "
