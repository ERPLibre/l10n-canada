#: model:ir.model.fields,field_description:l10n_ca_on_payroll.field_res_company__l10n_ca_on_eht_estimated_payroll
#: model:ir.model.fields,field_description:l10n_ca_on_payroll.field_res_config_settings__l10n_ca_on_eht_estimated_payroll
