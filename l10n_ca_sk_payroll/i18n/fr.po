#. module: l10n_ca_sk_payroll
#: model:l10n_ca.payroll.source,name:l10n_ca_sk_payroll.source_td1sk_2026
msgid "TD1SK 2026 Saskatchewan Personal Tax Credits Return"
msgstr ""
