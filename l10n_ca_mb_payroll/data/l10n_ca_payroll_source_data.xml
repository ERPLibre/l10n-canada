        <field name="sequence">100</field>
        <field name="jurisdiction">manitoba</field>
        <field name="kind">page</field>
        <field name="name">Reporting Payroll</field>
        <field name="publisher">WCB Manitoba</field>
        <field name="url">https://www.wcb.mb.ca/employers/premiums-and-payroll/reporting-payroll/</field>
