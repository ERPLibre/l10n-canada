        <field name="kind">publication</field>
        <field name="name">TD1MB 2026 Manitoba Personal Tax Credits Return</field>
        <field name="publisher">Canada Revenue Agency</field>
        <field name="reference">Line 1 (basic personal amount) and the total claim amount</field>
