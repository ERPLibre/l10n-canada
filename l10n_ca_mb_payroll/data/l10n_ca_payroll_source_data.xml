    <record id="source_levy_page" model="l10n_ca.payroll.source">
        <field name="sequence">50</field>
        <field name="jurisdiction">manitoba</field>
        <field name="kind">page</field>
        <field name="name">Health and Post Secondary Education Tax Levy</field>
        <field name="publisher">Manitoba Finance</field>
        <field name="url">https://www.gov.mb.ca/finance/taxation/taxes/payroll.html</field>
        <field name="summary">Employers with a total yearly payroll of 2.5 million or less are exempt; between 2.5 and 5.0 million, 4.3% on the amount in excess of 2.5 million (notch provision); over 5.0 million, 2.15% of the total payroll. Associated groups share the exemption on their combined payroll; a part-year employer prorates the exemption and the notch.</field>
        <field name="verified_date">2026-11-12</field>
    </record>
    <record id="source_levy_bulletin" model="l10n_ca.payroll.source">
        <field name="sequence">60</field>
        <field name="jurisdiction">manitoba</field>
        <field name="kind">publication</field>
        <field name="name">Information Bulletin HE 001, Information for Employers (revised January 2026)</field>
        <field name="publisher">Manitoba Finance</field>
        <field name="reference">Table of the recent exemption thresholds and notch ranges; monthly returns</field>
        <field name="url">https://www.gov.mb.ca/finance/taxation/pubs/bulletins/001he.pdf</field>
        <field name="summary">Exemption 2,250,000 and notch range up to 4,500,000 in 2025; 2,500,000 and up to 5,000,000 in 2026. Monthly return and payment by the 15th of the following month once the remuneration of the year exceeds the exemption; annual report by March 31 of the following year.</field>
        <field name="verified_date">2026-11-12</field>
    </record>
    <record id="source_levy_budget_2026" model="l10n_ca.payroll.source">
        <field name="sequence">70</field>
        <field name="jurisdiction">manitoba</field>
        <field name="kind">publication</field>
        <field name="name">Information Bulletin 126, Taxation Changes - Budget 2026</field>
        <field name="publisher">Manitoba Finance</field>
        <field name="url">https://www.gov.mb.ca/finance/taxation/pubs/bulletins/2026budget.pdf</field>
        <field name="summary">The tax measures of Budget 2026 include no change to the Health and Post Secondary Education Tax Levy: the 2026 amounts of the Act stand.</field>
        <field name="verified_date">2026-11-12</field>
    </record>
    <record id="source_levy_act" model="l10n_ca.payroll.source">
        <field name="sequence">80</field>
        <field name="jurisdiction">manitoba</field>
        <field name="kind">statute</field>
        <field name="name">The Health and Post Secondary Education Tax Levy Act, C.C.S.M. c. H24</field>
        <field name="publisher">Manitoba Laws</field>
        <field name="reference">Sections 2(3) (associated corporations), 3(3.1.1) (rate), 3(3.12) (exemption), 3(3.14) (notch provision), 3(3.15) (part-year proration)</field>
        <field name="url">https://web2.gov.mb.ca/laws/statutes/ccsm/h024.php?lang=en</field>
        <field name="summary">Levy of 2.15% of the remuneration paid in each month; no levy for a total remuneration of the year of 2,500,000 or less; 4.3% of the excess over 2,500,000 for a total of more than 2,500,000 and not more than 5,000,000. Associated corporations compute as a single employer and share the exemption or notch reduction.</field>
        <field name="verified_date">2026-11-12</field>
    </record>
    <record id="source_wcb_fact_sheet" model="l10n_ca.payroll.source">
        <field name="sequence">90</field>
        <field name="jurisdiction">manitoba</field>
        <field name="kind">page</field>
        <field name="name">Assessable Payroll Fact Sheet</field>
        <field name="publisher">WCB Manitoba</field>
        <field name="url">https://www.wcb.mb.ca/assessable-payroll-fact-sheet/</field>
        <field name="summary">Maximum level of assessable earnings per worker: 167,050 in 2025, 171,500 in 2026. Earnings above the maximum bear no premium; directors, sole proprietors and partners are deducted from the assessable payroll unless they buy personal coverage.</field>
        <field name="watch_key">wcb_mb_maximum</field>
        <field name="verified_date">2026-11-12</field>
    </record>
