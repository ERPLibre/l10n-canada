    <record id="source_t4127_122" model="l10n_ca.payroll.source">
        <field name="sequence">20</field>
        <field name="jurisdiction">manitoba</field>
        <field name="kind">publication</field>
        <field name="name">T4127 Payroll Deductions Formulas, 122nd Edition (January 1, 2026)</field>
        <field name="publisher">Canada Revenue Agency</field>
        <field name="reference">Chapter 1 (Manitoba), chapter 2 (Manitoba Basic Personal Amount (BPAMB) Formula), step 5, Manitoba (LCP); tables 8.1 and 8.2</field>
        <field name="url">https://www.canada.ca/en/revenue-agency/services/forms-publications/payroll/t4127-payroll-deductions-formulas/t4127-jan/t4127-jan-payroll-deductions-formulas-computer-programs.html</field>
        <field name="summary">Manitoba rates 10.8%, 12.75% and 17.4% from 47,000 and 100,000, not indexed from 2025; BPAMB of 15,780 up to a net income of 200,000, reduced linearly to 0 at 400,000; labour-sponsored funds credit LCP of 15% of the shares withheld, at most 1,800 a year.</field>
        <field name="verified_date">2026-11-12</field>
    </record>
