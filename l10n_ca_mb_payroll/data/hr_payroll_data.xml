<odoo noupdate="1">
    <!-- Payees of the Manitoba employer contributions. The Manitoba income
         tax is remitted to the CRA with the federal deductions. -->
    <record id="partner_manitoba_finance" model="res.partner">
        <field name="name">Manitoba Finance, Taxation Division</field>
        <field name="is_company" eval="True" />
        <field name="country_id" ref="base.ca" />
        <field name="state_id" ref="base.state_ca_mb" />
    </record>
    <record id="register_manitoba_finance" model="hr.contribution.register">
        <field name="name">Manitoba Finance, Taxation Division</field>
        <field name="partner_id" ref="partner_manitoba_finance" />
        <field name="company_id" eval="False" />
        <field
            name="note"
        >Manitoba Health and Post Secondary Education Tax Levy.</field>
    </record>
    <record id="partner_wcb_mb" model="res.partner">
        <field name="name">Workers Compensation Board of Manitoba</field>
        <field name="is_company" eval="True" />
        <field name="country_id" ref="base.ca" />
        <field name="state_id" ref="base.state_ca_mb" />
    </record>
    <record id="register_wcb_mb" model="hr.contribution.register">
        <field name="name">Workers Compensation Board of Manitoba</field>
        <field name="partner_id" ref="partner_wcb_mb" />
        <field name="company_id" eval="False" />
        <field name="note">Manitoba workers' compensation premiums.</field>
    </record>

    <!-- Every rule below applies only to an employment in Manitoba. The
         Manitoba income tax is the line of the federal rule CA_PIT. -->
    <record id="rule_mb_salary" model="hr.salary.rule">
        <field name="name">Manitoba Remuneration Subject to the Levy</field>
        <field name="code">CA_MB_SAL</field>
        <field name="sequence">114</field>
        <field name="appears_on_payslip" eval="False" />
        <field name="company_id" eval="False" />
        <field name="condition_select">python</field>
        <field
            name="condition_python"
        >result = contract.l10n_ca_province_id.code == "MB"</field>
        <field name="amount_select">code</field>
        <field
            name="amount_python_compute"
        >result = l10n_ca.get(contract, categories.GROSS)["province_remuneration"]</field>
        <field
            name="note"
        >Remuneration of the pay counted in the total Manitoba remuneration of the company: its year-to-date total consumes the levy exemption and gives the assessable earnings left after a credit note.</field>
    </record>
    <record id="rule_mb_wcb_insurable" model="hr.salary.rule">
        <field name="name">WCB Manitoba Assessable Earnings</field>
        <field name="code">CA_MB_WCB_IE</field>
        <field name="sequence">115</field>
        <field name="appears_on_payslip" eval="False" />
        <field name="company_id" eval="False" />
        <field name="condition_select">python</field>
        <field
            name="condition_python"
        >result = contract.l10n_ca_province_id.code == "MB"</field>
        <field name="amount_select">code</field>
        <field
            name="amount_python_compute"
        >result = l10n_ca.get(contract, categories.GROSS)["wcb_insurable"]</field>
        <field
            name="note"
        >Assessable earnings of the pay up to the WCB Manitoba yearly maximum, less the assessable earnings of the year so far; 0 for a contract not covered.</field>
    </record>
    <record id="rule_mb_employer_tax" model="hr.salary.rule">
        <field name="name">Health and Post Secondary Education Tax Levy</field>
        <field name="code">CA_MB_ER_TAX</field>
        <field name="sequence">370</field>
        <field name="category_id" ref="l10n_ca_payroll.categ_comp" />
        <field name="register_id" ref="register_manitoba_finance" />
        <field name="company_id" eval="False" />
        <field name="condition_select">python</field>
        <field
            name="condition_python"
        >result = contract.l10n_ca_province_id.code == "MB" and l10n_ca.get(contract, categories.GROSS)["employer_tax"] != 0</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">ca = l10n_ca.get(contract, categories.GROSS)
result = ca["employer_tax"]
result_name = ca["employer_tax_line_name"]</field>
        <field
            name="note"
        >Accrual of the Health and Post Secondary Education Tax Levy: the rate of the annual total Manitoba remuneration of the company (4.3% in the notch range, 2.15% above it) applied to the remuneration of the pay above the exemption left in the year.</field>
    </record>
    <record id="rule_mb_wcb" model="hr.salary.rule">
        <field name="name">WCB Manitoba Premium</field>
        <field name="code">CA_MB_WCB</field>
        <field name="sequence">380</field>
        <field name="category_id" ref="l10n_ca_payroll.categ_comp" />
        <field name="register_id" ref="register_wcb_mb" />
        <field name="company_id" eval="False" />
        <field name="condition_select">python</field>
        <field
            name="condition_python"
        >result = contract.l10n_ca_province_id.code == "MB" and l10n_ca.get(contract, categories.GROSS)["wcb"] != 0</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">ca = l10n_ca.get(contract, categories.GROSS)
result = ca["wcb"]
result_name = ca["wcb_line_name"]</field>
        <field
            name="note"
        >WCB Manitoba premium at the rate per $100 of the provincial payroll account of the company, on the assessable earnings of the pay up to the yearly maximum.</field>
    </record>
</odoo>
