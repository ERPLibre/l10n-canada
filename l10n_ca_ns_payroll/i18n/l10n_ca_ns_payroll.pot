#. module: l10n_ca_ns_payroll
#: model:l10n_ca.payroll.source,summary:l10n_ca_ns_payroll.source_td1ns_2026
msgid ""
"Nova Scotia basic personal amount of 11,932 for 2026 and the total claim "
"amount TCP entered on the contract."
msgstr ""

#. module: l10n_ca_ns_payroll
#: model:l10n_ca.payroll.source,summary:l10n_ca_ns_payroll.source_t4127_122
msgid ""
"Nova Scotia rates 8.79%, 14.95%, 16.67%, 17.5% and 21% from 30,995, 61,991, "
"97,417 and 157,124; basic personal amount 11,932, the same for every income "
"since the BPANS formula is removed for 2026; labour-sponsored funds credit "
"LCP of 20% of the shares withheld, at most 2,000 a year."
msgstr ""

#. module: l10n_ca_ns_payroll
#: model:l10n_ca.payroll.source,summary:l10n_ca_ns_payroll.source_finance_personal
msgid ""
"Nova Scotia taxable income brackets of 2026 (8.79% to 30,995, 14.95% to "
"61,991, 16.67% to 97,417, 17.5% to 157,124, 21% above) and basic personal "
"amount of 11,932; indexation rate of 1.6% for 2026."
msgstr ""

