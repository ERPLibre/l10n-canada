<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.l10n_ca_tax_return</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="inside">
                <block
                    title="Canadian Sales Tax Returns"
                    name="l10n_ca_tax_return"
                    invisible="country_code != 'CA'"
                >
                    <!-- A setting labels its first field only: each field
                         gets its own label row. -->
                    <setting
                        string="Closing Entries"
                        help="Accounts that receive the net tax when a return is closed"
                    >
                        <div class="content-group">
                            <div class="row mt8">
                                <label
                                    for="l10n_ca_gst_authority_account_id"
                                    class="col-lg-5 o_light_label"
                                />
                                <field name="l10n_ca_gst_authority_account_id" />
                            </div>
                            <div class="row mt8">
                                <label
                                    for="l10n_ca_qst_authority_account_id"
                                    class="col-lg-5 o_light_label"
                                />
                                <field name="l10n_ca_qst_authority_account_id" />
                            </div>
                            <div class="row mt8">
                                <label
                                    for="l10n_ca_quick_method_gain_account_id"
                                    class="col-lg-5 o_light_label"
                                />
                                <field name="l10n_ca_quick_method_gain_account_id" />
                            </div>
                            <div class="row mt8">
                                <label
                                    for="l10n_ca_tax_closing_journal_id"
                                    class="col-lg-5 o_light_label"
                                />
                                <field name="l10n_ca_tax_closing_journal_id" />
                            </div>
                        </div>
                    </setting>
                    <setting
                        string="Bad Debts"
                        help="Default accounts of the bad debt write-off and recovery"
                    >
                        <div class="content-group">
                            <div class="row mt8">
                                <label
                                    for="l10n_ca_bad_debt_account_id"
                                    class="col-lg-5 o_light_label"
                                />
                                <field name="l10n_ca_bad_debt_account_id" />
                            </div>
                            <div class="row mt8">
                                <label
                                    for="l10n_ca_bad_debt_recovery_account_id"
                                    class="col-lg-5 o_light_label"
                                />
                                <field name="l10n_ca_bad_debt_recovery_account_id" />
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
