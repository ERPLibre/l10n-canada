<odoo>
    <record id="view_move_form" model="ir.ui.view">
        <field name="name">account.move.form.l10n_ca_tax_return</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='button_draft']" position="before">
                <button
                    name="action_l10n_ca_bad_debt"
                    type="object"
                    string="Bad Debt"
                    groups="account.group_account_user,account.group_account_manager"
                    invisible="move_type != 'out_invoice' or state != 'posted' or country_code != 'CA' or (payment_state in ('paid', 'in_payment', 'reversed') and not l10n_ca_bad_debt_move_ids)"
                />
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_l10n_ca_open_bad_debt_moves"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-chain-broken"
                    invisible="not l10n_ca_bad_debt_move_ids"
                >
                    <field
                        name="l10n_ca_bad_debt_written_off"
                        widget="statinfo"
                        string="Bad Debt"
                    />
                </button>
                <field name="l10n_ca_bad_debt_move_ids" invisible="True" />
            </xpath>
            <xpath expr="//field[@name='ref'][not(@nolabel)]" position="after">
                <field
                    name="l10n_ca_bad_debt_origin_id"
                    invisible="not l10n_ca_bad_debt_origin_id"
                />
                <field
                    name="l10n_ca_bad_debt_type"
                    invisible="not l10n_ca_bad_debt_type"
                />
            </xpath>
        </field>
    </record>
</odoo>
