<odoo>
    <record id="action_report_tax_return" model="ir.actions.report">
        <field name="name">Sales Tax Return (PDF)</field>
        <field name="model">l10n.ca.tax.return</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_ca_tax_return.report_tax_return</field>
        <field name="report_file">l10n_ca_tax_return.report_tax_return</field>
        <field name="print_report_name">'Tax return - %s' % object.name</field>
        <field name="binding_model_id" ref="model_l10n_ca_tax_return" />
        <field name="binding_type">report</field>
    </record>
    <record id="action_report_tax_return_xlsx" model="ir.actions.report">
        <field name="name">Sales Tax Return (XLSX)</field>
        <field name="model">l10n.ca.tax.return</field>
        <field name="report_type">xlsx</field>
        <field name="report_name">l10n_ca_tax_return.tax_return_xlsx</field>
        <field name="report_file">l10n_ca_tax_return_xlsx</field>
        <field name="binding_model_id" ref="model_l10n_ca_tax_return" />
        <field name="binding_type">report</field>
    </record>

    <template id="report_tax_return_document">
        <t t-call="web.external_layout">
            <t t-set="o" t-value="o.with_context(lang=o.company_id.partner_id.lang)" />
            <div class="page">
                <h3 t-field="o.name" />
                <div class="row mb-3">
                    <div class="col-6">
                        <div>
                            <strong>Company:</strong>
                            <span t-field="o.company_id.name" />
                        </div>
                        <div t-if="o.company_id.vat">
                            <strong>Business number:</strong>
                            <span t-field="o.company_id.vat" />
                        </div>
                        <div t-if="o.company_id.l10n_ca_neq">
                            <strong>Quebec enterprise number:</strong>
                            <span t-field="o.company_id.l10n_ca_neq" />
                        </div>
                    </div>
                    <div class="col-6">
                        <div>
                            <strong>Period:</strong>
                            <span t-field="o.date_from" />
                            -
                            <span t-field="o.date_to" />
                        </div>
                        <div>
                            <strong>Method:</strong>
                            <span t-field="o.method" />
                        </div>
                        <div t-if="o.date_due">
                            <strong>Due date:</strong>
                            <span t-field="o.date_due" />
                        </div>
                        <div>
                            <strong>Status:</strong>
                            <span t-field="o.state" />
                        </div>
                    </div>
                </div>
                <table class="table table-sm o_main_table">
                    <thead>
                        <tr>
                            <th class="text-start">Line</th>
                            <th class="text-start">Description</th>
                            <th class="text-end">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr
                            t-foreach="o.line_ids"
                            t-as="line"
                            t-att-class="'fw-bold' if line.hierarchy_level &lt;= 1 else ''"
                        >
                            <td>
                                <span t-field="line.code" />
                            </td>
                            <td>
                                <span t-field="line.name" />
                                <em t-if="line.is_quick_method"> (quick method)</em>
                            </td>
                            <td class="text-end">
                                <span
                                    t-field="line.amount"
                                    t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"
                                />
                            </td>
                        </tr>
                    </tbody>
                </table>
                <div t-if="o.method == 'quick'" class="mt-2">
                    <strong>Quick method gain:</strong>
                    <span
                        t-field="o.quick_method_gain"
                        t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"
                    />
                    <p t-if="o.quick_method_note" t-field="o.quick_method_note" />
                </div>
                <div t-if="o.filing_date" class="mt-2">
                    <strong>Filed on:</strong>
                    <span t-field="o.filing_date" />
                    <t t-if="o.confirmation_number">
                        <strong>Confirmation number:</strong>
                        <span t-field="o.confirmation_number" />
                    </t>
                </div>
            </div>
        </t>
    </template>

    <template id="report_tax_return">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="l10n_ca_tax_return.report_tax_return_document" />
            </t>
        </t>
    </template>
</odoo>
