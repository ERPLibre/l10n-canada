<odoo>
    <record id="l10n_ca_tax_return_company_rule" model="ir.rule">
        <field name="name">Canadian sales tax return: multi-company</field>
        <field name="model_id" ref="model_l10n_ca_tax_return" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="l10n_ca_tax_return_line_company_rule" model="ir.rule">
        <field name="name">Canadian sales tax return line: multi-company</field>
        <field name="model_id" ref="model_l10n_ca_tax_return_line" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
