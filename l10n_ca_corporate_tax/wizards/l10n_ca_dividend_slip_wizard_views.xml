<odoo>
    <record id="view_l10n_ca_dividend_slip_wizard_form" model="ir.ui.view">
        <field name="name">l10n.ca.dividend.slip.wizard.form</field>
        <field name="model">l10n.ca.dividend.slip.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="year" />
                    <field name="company_id" groups="base.group_multi_company" />
                    <field name="currency_id" invisible="1" />
                </group>
                <group invisible="not csv_file">
                    <group string="T5 Summary">
                        <field name="t5_count" />
                        <field name="t5_box_24" />
                        <field name="t5_box_25" />
                        <field name="t5_box_26" />
                        <field name="t5_box_10" />
                        <field name="t5_box_11" />
                        <field name="t5_box_12" />
                    </group>
                    <group string="RL-3 Summary">
                        <field name="rl3_count" />
                        <field name="rl3_box_a1" />
                        <field name="rl3_box_a2" />
                        <field name="rl3_box_b" />
                        <field name="rl3_box_c" />
                    </group>
                    <field name="csv_filename" invisible="1" />
                    <field name="csv_file" filename="csv_filename" />
                </group>
                <footer>
                    <button name="action_generate" type="object" string="Generate" class="btn-primary" />
                    <button name="action_open_slips" type="object" string="Open Slips" invisible="not csv_file" />
                    <button special="cancel" string="Close" />
                </footer>
            </form>
        </field>
    </record>
    <record id="action_l10n_ca_dividend_slip_wizard" model="ir.actions.act_window">
        <field name="name">Generate T5 and RL-3 Slips</field>
        <field name="res_model">l10n.ca.dividend.slip.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <menuitem
        id="menu_l10n_ca_dividend_slip_wizard"
        name="Generate T5 and RL-3 Slips"
        parent="menu_l10n_ca_corporate_tax"
        action="action_l10n_ca_dividend_slip_wizard"
        sequence="70"
    />
</odoo>
