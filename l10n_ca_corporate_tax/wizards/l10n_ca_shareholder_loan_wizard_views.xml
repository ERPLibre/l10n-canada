<odoo>
    <record id="view_l10n_ca_shareholder_loan_wizard_form" model="ir.ui.view">
        <field name="name">l10n.ca.shareholder.loan.wizard.form</field>
        <field name="model">l10n.ca.shareholder.loan.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="date_from" />
                    <field name="date_to" />
                    <field name="as_of" />
                    <field name="company_id" groups="base.group_multi_company" />
                </group>
                <footer>
                    <button name="action_compute" type="object" string="Compute" class="btn-primary" />
                    <button special="cancel" string="Cancel" />
                </footer>
            </form>
        </field>
    </record>
    <record id="action_l10n_ca_shareholder_loan_wizard" model="ir.actions.act_window">
        <field name="name">Compute Shareholder Loans</field>
        <field name="res_model">l10n.ca.shareholder.loan.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <menuitem
        id="menu_l10n_ca_shareholder_loan_wizard"
        name="Compute Shareholder Loans"
        parent="menu_l10n_ca_corporate_tax"
        action="action_l10n_ca_shareholder_loan_wizard"
        sequence="20"
    />
</odoo>
