<odoo>
    <record id="view_partner_property_form" model="ir.ui.view">
        <field name="name">res.partner.form.l10n_ca_corporate_tax</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="account.view_partner_property_form" />
        <field name="arch" type="xml">
            <group name="accounting_entries" position="after">
                <group
                    string="Shareholder (Canada)"
                    name="l10n_ca_shareholder"
                    groups="account.group_account_manager,account.group_account_user,account.group_account_readonly"
                >
                    <field name="l10n_ca_shareholder" />
                    <field name="l10n_ca_related_person" />
                </group>
            </group>
        </field>
    </record>
</odoo>
