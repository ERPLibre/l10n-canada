<odoo>
    <record id="view_l10n_ca_dividend_slip_list" model="ir.ui.view">
        <field name="name">l10n.ca.dividend.slip.list</field>
        <field name="model">l10n.ca.dividend.slip</field>
        <field name="arch" type="xml">
            <list create="false">
                <field name="year" />
                <field name="partner_id" />
                <field name="t5_required" />
                <field name="t5_box_24" sum="Total" />
                <field name="t5_box_25" sum="Total" />
                <field name="t5_box_26" sum="Total" />
                <field name="t5_box_10" sum="Total" />
                <field name="t5_box_11" sum="Total" />
                <field name="t5_box_12" sum="Total" />
                <field name="rl3_box_a1" sum="Total" />
                <field name="rl3_box_a2" sum="Total" />
                <field name="rl3_box_b" sum="Total" />
                <field name="rl3_box_c" sum="Total" />
                <field name="company_id" groups="base.group_multi_company" optional="hide" />
                <field name="currency_id" column_invisible="1" />
            </list>
        </field>
    </record>
    <record id="view_l10n_ca_dividend_slip_form" model="ir.ui.view">
        <field name="name">l10n.ca.dividend.slip.form</field>
        <field name="model">l10n.ca.dividend.slip</field>
        <field name="arch" type="xml">
            <form create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="year" />
                            <field name="partner_id" />
                            <field name="t5_required" />
                            <field name="currency_id" invisible="1" />
                        </group>
                    </group>
                    <group>
                        <group string="T5 (CRA)">
                            <field name="t5_box_24" />
                            <field name="t5_box_25" />
                            <field name="t5_box_26" />
                            <field name="t5_box_10" />
                            <field name="t5_box_11" />
                            <field name="t5_box_12" />
                        </group>
                        <group string="RL-3 (Revenu Quebec)">
                            <field name="rl3_box_a1" />
                            <field name="rl3_box_a2" />
                            <field name="rl3_box_b" />
                            <field name="rl3_box_c" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_l10n_ca_dividend_slip_search" model="ir.ui.view">
        <field name="name">l10n.ca.dividend.slip.search</field>
        <field name="model">l10n.ca.dividend.slip</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id" />
                <field name="year" />
                <group expand="0" string="Group By">
                    <filter name="group_year" string="Year" context="{'group_by': 'year'}" />
                </group>
            </search>
        </field>
    </record>
    <record id="action_l10n_ca_dividend_slip" model="ir.actions.act_window">
        <field name="name">T5 and RL-3 Slips</field>
        <field name="res_model">l10n.ca.dividend.slip</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_year': 1}</field>
    </record>
    <menuitem
        id="menu_l10n_ca_dividend_slip"
        name="T5 and RL-3 Slips"
        parent="menu_l10n_ca_corporate_tax"
        action="action_l10n_ca_dividend_slip"
        sequence="60"
    />
</odoo>
