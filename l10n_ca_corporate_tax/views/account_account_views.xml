<odoo>
    <record id="view_account_form" model="ir.ui.view">
        <field name="name">account.account.form.l10n_ca_corporate_tax</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account.view_account_form" />
        <field name="arch" type="xml">
            <field name="allowed_journal_ids" position="after">
                <field
                    name="l10n_ca_shareholder_loan"
                    invisible="account_type not in ('asset_receivable', 'asset_current', 'asset_non_current', 'liability_current', 'liability_payable', 'liability_non_current')"
                />
                <field
                    name="l10n_ca_tax_treatment"
                    invisible="account_type not in ('income', 'income_other', 'expense', 'expense_direct_cost')"
                />
            </field>
        </field>
    </record>
    <record id="view_account_list" model="ir.ui.view">
        <field name="name">account.account.list.l10n_ca_corporate_tax</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account.view_account_list" />
        <field name="arch" type="xml">
            <field name="account_type" position="after">
                <field name="l10n_ca_shareholder_loan" optional="hide" />
                <field name="l10n_ca_tax_treatment" optional="hide" />
            </field>
        </field>
    </record>
</odoo>
