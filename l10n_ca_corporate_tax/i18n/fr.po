#. odoo-python
#: code:addons/l10n_ca_corporate_tax/models/l10n_ca_shareholder_loan.py:0
msgid ""
"%(amount)s %(currency)s lent to %(partner)s in the fiscal year ending "
"%(year_end)s is still unpaid. Unless it is repaid by %(deadline)s, it is "
"taxable to the shareholder (ITA s. 15(2))."
msgstr ""
"Le montant de %(amount)s %(currency)s prêté à %(partner)s au cours de "
"l'exercice se terminant le %(year_end)s est toujours impayé. À moins d'être "
"remboursé au plus tard le %(deadline)s, il est imposable pour l'actionnaire "
"(LIR, par. 15(2))."

#. module: l10n_ca_corporate_tax
#: model_terms:ir.ui.view,arch_db:l10n_ca_corporate_tax.view_l10n_ca_corporate_tax_estimate_form
msgid ""
"<strong>Estimate only.</strong> This page helps plan the corporate\n"
"                        income tax and the instalments; it is not a T2 or CO-17 return."
msgstr ""
"<strong>Estimation seulement.</strong> Cette page aide à planifier l'impôt sur le revenu\n"
"                        des sociétés et les acomptes provisionnels; ce n'est pas une déclaration T2 ou CO-17."

