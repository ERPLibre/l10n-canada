        <field name="jurisdiction">british_columbia</field>
        <field name="kind">page</field>
        <field
            name="name"
        >Employer Health Tax: Charitable and Non-Profit Employers</field>
        <field name="publisher">Government of British Columbia</field>
        <field
            name="url"
        >https://www2.gov.bc.ca/gov/content/taxes/employer-health-tax/employer-health-tax-overview/eht-charitable-nonprofit</field>
        <field
            name="summary"
        >Exemption of 1,500,000 per qualifying location; 2.925% x (remuneration - 1,500,000) up to 4,500,000; 1.95% of the remuneration above. A remuneration of 2,500,000 bears 29,250.</field>
        <field name="verified_date">2026-11-12</field>
    </record>
