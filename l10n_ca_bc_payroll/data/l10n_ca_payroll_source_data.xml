    <record id="source_employer_health_tax_act" model="l10n_ca.payroll.source">
        <field name="sequence">70</field>
        <field name="jurisdiction">british_columbia</field>
        <field name="kind">statute</field>
        <field name="name">Employer Health Tax Act, SBC 2018, c. 42</field>
        <field name="publisher">King's Printer for British Columbia</field>
        <field
            name="reference"
        >Sections 8, 10 and 11 (rate, exemption, notch); 13 to 18 (associated employers); 20, 21 and 29 (charitable or non-profit employers); 32 and 41 (return and instalments)</field>
        <field
            name="url"
        >https://www.bclaws.gov.bc.ca/civix/document/id/complete/statreg/18042</field>
        <field
            name="summary"
        >Tax of 1.95% of the British Columbia remuneration of the year; none up to 1,000,000; 5.85% of the excess over 1,000,000 up to 1,500,000. Charitable or non-profit employers: none up to 1,500,000 per qualifying location, 2.925% of the excess up to 4,500,000, 1.95% above. Associated employers share one exemption by an allocation agreement.</field>
        <field name="verified_date">2026-11-12</field>
    </record>
    <record id="source_eht_overview" model="l10n_ca.payroll.source">
        <field name="sequence">80</field>
        <field name="jurisdiction">british_columbia</field>
        <field name="kind">page</field>
        <field name="name">Employer Health Tax Overview</field>
        <field name="publisher">Government of British Columbia</field>
        <field
            name="url"
        >https://www2.gov.bc.ca/gov/content/taxes/employer-health-tax/employer-health-tax-overview</field>
        <field
            name="summary"
        >Since the return for 2024: no tax on a British Columbia remuneration of 1,000,000 or less; 5.85% x (remuneration - 1,000,000) between 1,000,000.01 and 1,500,000; 1.95% of the total remuneration above 1,500,000.</field>
        <field name="verified_date">2026-11-12</field>
    </record>
    <record id="source_eht_charities" model="l10n_ca.payroll.source">
