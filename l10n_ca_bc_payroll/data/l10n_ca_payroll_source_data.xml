    <record id="source_eht_file_pay" model="l10n_ca.payroll.source">
        <field name="sequence">110</field>
        <field name="jurisdiction">british_columbia</field>
        <field name="kind">page</field>
        <field name="name">Employer Health Tax: File and Pay</field>
        <field name="publisher">Government of British Columbia</field>
