    <record id="source_t4127_123" model="l10n_ca.payroll.source">
        <field name="sequence">10</field>
        <field name="jurisdiction">british_columbia</field>
        <field name="kind">publication</field>
        <field
            name="name"
        >T4127 Payroll Deductions Formulas, 123rd Edition (July 1, 2026)</field>
        <field name="publisher">Canada Revenue Agency</field>
        <field
            name="reference"
        >What's new for July 1, 2026 (British Columbia); Upcoming changes for January 1, 2027; step 5, British Columbia (K1P, K2P, S); tables 8.1 and 8.2</field>
        <field
            name="url"
        >https://www.canada.ca/en/revenue-agency/services/forms-publications/payroll/t4127-payroll-deductions-formulas/t4127-jul/t4127-jul-payroll-deductions-formulas.html</field>
        <field
            name="summary"
        >Lowest British Columbia rate of 5.60% for 2026 and later years, applied as 6.14% from the first pay of July 2026 (constants KP 786 to 22,884); basic reduction S2 of 690 for 2026 and later years, applied as 805 from July 2026, with the maximum income of the reduction at 44,952. Indexation of the brackets and of the non-refundable tax credits paused for 2027 to 2030 at their 2026 levels.</field>
        <field name="verified_date">2026-11-12</field>
    </record>
