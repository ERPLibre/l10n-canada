<odoo noupdate="1">
    <!-- Salary rule categories -->
    <record id="categ_basic" model="hr.salary.rule.category">
        <field name="name">Basic</field>
        <field name="code">BASIC</field>
        <field name="company_id" eval="False" />
    </record>
    <record id="categ_gross" model="hr.salary.rule.category">
        <field name="name">Gross</field>
        <field name="code">GROSS</field>
        <field name="company_id" eval="False" />
    </record>
    <record id="categ_ded" model="hr.salary.rule.category">
        <field name="name">Deduction</field>
        <field name="code">DED</field>
        <field name="company_id" eval="False" />
    </record>
    <record id="categ_net" model="hr.salary.rule.category">
        <field name="name">Net</field>
        <field name="code">NET</field>
        <field name="company_id" eval="False" />
    </record>
    <record id="categ_comp" model="hr.salary.rule.category">
        <field name="name">Employer Contribution</field>
        <field name="code">COMP</field>
        <field name="company_id" eval="False" />
    </record>
    <!-- B of the bonus formulas: the rules of these two categories must
         run before the statutory rules (sequence below 100), which read
         the category totals once. -->
    <record id="categ_lump" model="hr.salary.rule.category">
        <field name="name">Bonuses and Lump-Sum Payments</field>
        <field name="code">CA_LUMP</field>
        <field name="company_id" eval="False" />
        <field
            name="note"
        >Non-periodic payments taxed with the bonus formulas (B of T4127, B2 of TP-1015.F): bonus, retroactive pay increase, accumulated overtime or vacation pay not taken. They are part of the gross remuneration. Give the rules a sequence below 100.</field>
    </record>
    <record id="categ_lump_ded" model="hr.salary.rule.category">
        <field name="name">Deduction From a Bonus or Lump-Sum Payment</field>
        <field name="code">CA_LUMP_DED</field>
        <field name="parent_id" ref="categ_ded" />
        <field name="company_id" eval="False" />
        <field
            name="note"
        >RPP or RRSP contributions withheld from the non-periodic payments of the period (F3 of T4127; the reduction of B2 in TP-1015.F). They lower the payment taxed with the bonus formulas. Give the rules a sequence below 100.</field>
    </record>
    <!-- F of T4127 and TP-1015.F: the rules of this category must run
         before the statutory rules (sequence below 100), which read the
         category total once. -->
    <record id="categ_tax_ded" model="hr.salary.rule.category">
        <field name="name">Deduction Reducing the Taxable Income</field>
        <field name="code">CA_TAX_DED</field>
        <field name="parent_id" ref="categ_ded" />
        <field name="company_id" eval="False" />
        <field
            name="note"
        >Employee contributions to an RPP, an RRSP, a PRPP or a VRSP, or to a retirement compensation arrangement, withheld from the regular pay of the period (F of T4127 and of TP-1015.F). They lower the taxable income of the pay, not the pensionable or insurable earnings. Give the rules a sequence below 100.</field>
    </record>
    <!-- U1 and F2 of T4127: the rules of this category lower A, the
         taxable income of the CRA formulas, but not the Quebec taxable
         income of TP-1015.F. They must run before the statutory rules
         (sequence below 100). -->
    <record id="categ_fed_tax_ded" model="hr.salary.rule.category">
        <field name="name">Deduction Reducing the CRA Taxable Income</field>
        <field name="code">CA_FED_TAX_DED</field>
        <field name="parent_id" ref="categ_ded" />
        <field name="company_id" eval="False" />
        <field
            name="note"
        >Union dues (U1 of T4127) and alimony or maintenance payments under a legal document dated before May 1, 1997 (F2), withheld from the regular pay of the period. They lower the annual taxable income A of the federal and provincial formulas of the CRA; TP-1015.F does not subtract them from the Quebec taxable income. Give the rules a sequence below 100.</field>
    </record>

    <!-- Payee of the federal source deductions -->
    <record id="partner_receiver_general" model="res.partner">
        <field name="name">Receiver General for Canada</field>
        <field name="is_company" eval="True" />
        <field name="country_id" ref="base.ca" />
    </record>
    <record id="register_receiver_general" model="hr.contribution.register">
        <field name="name">Receiver General for Canada</field>
        <field name="partner_id" ref="partner_receiver_general" />
        <field name="company_id" eval="False" />
        <field
            name="note"
        >Federal source deductions (CPP, EI, income tax) remitted to the CRA.</field>
    </record>

    <!-- Earnings -->
    <record id="rule_basic" model="hr.salary.rule">
        <field name="name">Basic Salary</field>
        <field name="code">BASIC</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="categ_basic" />
        <field name="company_id" eval="False" />
        <field name="amount_select">code</field>
        <field name="amount_python_compute">result = l10n_ca.period_wage(contract)</field>
        <field
            name="note"
        >Monthly wage of the contract converted to the pay period: wage * 12 / pay periods per year.</field>
    </record>
    <record id="rule_bonus" model="hr.salary.rule">
        <field name="name">Bonus</field>
        <field name="code">CA_BONUS</field>
        <field name="sequence">20</field>
        <field name="category_id" ref="categ_lump" />
        <field name="company_id" eval="False" />
        <field name="condition_select">python</field>
        <field
            name="condition_python"
        >result = bool(inputs.CA_BONUS and inputs.CA_BONUS.amount)</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">result = inputs.CA_BONUS.amount</field>
        <field
            name="note"
        >Amount of the Bonus input of the payslip, taxed with the bonus formulas of T4127 and TP-1015.F.</field>
    </record>
    <record id="rule_input_bonus" model="hr.rule.input">
        <field name="name">Bonus</field>
        <field name="code">CA_BONUS</field>
        <field name="input_id" ref="rule_bonus" />
    </record>

    <!-- Retirement savings withheld from the pay (F) -->
    <record id="rule_rpp" model="hr.salary.rule">
        <field name="name">RPP Contribution</field>
        <field name="code">CA_RPP</field>
        <field name="sequence">30</field>
        <field name="category_id" ref="categ_tax_ded" />
        <field name="company_id" eval="False" />
        <field name="condition_select">python</field>
        <field
            name="condition_python"
        >result = bool(contract.l10n_ca_rpp_amount or (inputs.CA_RPP and inputs.CA_RPP.amount))</field>
        <field name="amount_select">code</field>
        <field
            name="amount_python_compute"
        >result = -(contract.l10n_ca_rpp_amount + (inputs.CA_RPP.amount if inputs.CA_RPP else 0.0))</field>
        <field
            name="note"
        >Employee registered pension plan contribution: the amount per pay of the contract plus the RPP input of the payslip. Box 20 of the T4, box D of the RL-1.</field>
    </record>
    <record id="rule_input_rpp" model="hr.rule.input">
        <field name="name">RPP Contribution</field>
        <field name="code">CA_RPP</field>
        <field name="input_id" ref="rule_rpp" />
    </record>
    <record id="rule_rrsp" model="hr.salary.rule">
        <field name="name">RRSP Contribution</field>
        <field name="code">CA_RRSP</field>
        <field name="sequence">31</field>
        <field name="category_id" ref="categ_tax_ded" />
        <field name="company_id" eval="False" />
        <field name="condition_select">python</field>
        <field
            name="condition_python"
        >result = bool(contract.l10n_ca_rrsp_amount or (inputs.CA_RRSP and inputs.CA_RRSP.amount))</field>
        <field name="amount_select">code</field>
        <field
            name="amount_python_compute"
        >result = -(contract.l10n_ca_rrsp_amount + (inputs.CA_RRSP.amount if inputs.CA_RRSP else 0.0))</field>
        <field
            name="note"
        >Employee RRSP, PRPP or VRSP contribution: the amount per pay of the contract plus the RRSP input of the payslip.</field>
    </record>
    <record id="rule_input_rrsp" model="hr.rule.input">
        <field name="name">RRSP Contribution</field>
        <field name="code">CA_RRSP</field>
        <field name="input_id" ref="rule_rrsp" />
    </record>
    <record id="rule_union" model="hr.salary.rule">
        <field name="name">Union Dues</field>
        <field name="code">CA_UNION</field>
        <field name="sequence">32</field>
        <field name="category_id" ref="categ_fed_tax_ded" />
        <field name="company_id" eval="False" />
        <field name="condition_select">python</field>
        <field
            name="condition_python"
        >result = bool(contract.l10n_ca_union_dues_amount or (inputs.CA_UNION and inputs.CA_UNION.amount))</field>
        <field name="amount_select">code</field>
        <field
            name="amount_python_compute"
        >result = -(contract.l10n_ca_union_dues_amount + (inputs.CA_UNION.amount if inputs.CA_UNION else 0.0))</field>
        <field
            name="note"
        >Union dues: the amount per pay of the contract plus the union dues input of the payslip. U1 of T4127; box 44 of the T4, box F of the RL-1.</field>
    </record>
    <record id="rule_input_union" model="hr.rule.input">
        <field name="name">Union Dues</field>
        <field name="code">CA_UNION</field>
        <field name="input_id" ref="rule_union" />
    </record>
    <record id="rule_support" model="hr.salary.rule">
        <field name="name">Support Payments</field>
        <field name="code">CA_SUPPORT</field>
        <field name="sequence">33</field>
        <field name="category_id" ref="categ_fed_tax_ded" />
        <field name="company_id" eval="False" />
        <field name="condition_select">python</field>
        <field
            name="condition_python"
        >result = bool(contract.l10n_ca_support_amount or (inputs.CA_SUPPORT and inputs.CA_SUPPORT.amount))</field>
        <field name="amount_select">code</field>
        <field
            name="amount_python_compute"
        >result = -(contract.l10n_ca_support_amount + (inputs.CA_SUPPORT.amount if inputs.CA_SUPPORT else 0.0))</field>
        <field
            name="note"
        >Alimony or maintenance payments under a legal document dated before May 1, 1997: the amount per pay of the contract plus the support input of the payslip. F2 of T4127.</field>
    </record>
    <record id="rule_input_support" model="hr.rule.input">
        <field name="name">Support Payments</field>
        <field name="code">CA_SUPPORT</field>
        <field name="input_id" ref="rule_support" />
    </record>
    <record id="rule_lsvcc" model="hr.salary.rule">
        <field name="name">Labour-Sponsored Fund Shares</field>
        <field name="code">CA_LSVCC</field>
        <field name="sequence">34</field>
        <field name="category_id" ref="categ_ded" />
        <field name="company_id" eval="False" />
        <field name="condition_select">python</field>
        <field
            name="condition_python"
        >result = bool(contract.l10n_ca_lsvcc_amount or (inputs.CA_LSVCC and inputs.CA_LSVCC.amount))</field>
        <field name="amount_select">code</field>
        <field
            name="amount_python_compute"
        >result = -(contract.l10n_ca_lsvcc_amount + (inputs.CA_LSVCC.amount if inputs.CA_LSVCC else 0.0))</field>
        <field
            name="note"
        >Shares of a labour-sponsored venture capital corporation bought by payroll deduction: the amount per pay of the contract plus the input of the payslip. They do not lower the taxable income; the provinces that grant a labour-sponsored funds tax credit lower their tax by it (LCP of T4127).</field>
    </record>
    <record id="rule_input_lsvcc" model="hr.rule.input">
        <field name="name">Labour-Sponsored Fund Shares</field>
        <field name="code">CA_LSVCC</field>
        <field name="input_id" ref="rule_lsvcc" />
    </record>
    <record id="rule_gross" model="hr.salary.rule">
        <field name="name">Gross</field>
        <field name="code">GROSS</field>
        <field name="sequence">100</field>
        <field name="category_id" ref="categ_gross" />
        <field name="company_id" eval="False" />
        <field name="amount_select">code</field>
        <field
            name="amount_python_compute"
        >result = categories.BASIC + categories.CA_LUMP</field>
        <field
            name="note"
        >Taxable, pensionable and insurable remuneration of the period (box 14 of the T4).</field>
    </record>
    <record id="rule_pensionable" model="hr.salary.rule">
        <field name="name">CPP/QPP Pensionable Earnings</field>
        <field name="code">CA_PE</field>
        <field name="sequence">110</field>
        <field name="appears_on_payslip" eval="False" />
        <field name="company_id" eval="False" />
        <field name="amount_select">code</field>
        <field
            name="amount_python_compute"
        >result = l10n_ca.get(contract, categories.GROSS)["pensionable"]</field>
    </record>
    <record id="rule_insurable" model="hr.salary.rule">
        <field name="name">EI Insurable Earnings</field>
        <field name="code">CA_IE</field>
        <field name="sequence">111</field>
        <field name="appears_on_payslip" eval="False" />
        <field name="company_id" eval="False" />
        <field name="amount_select">code</field>
        <field
            name="amount_python_compute"
        >result = l10n_ca.get(contract, categories.GROSS)["insurable"]</field>
    </record>
    <record id="rule_nonperiodic" model="hr.salary.rule">
        <field name="name">Non-Periodic Payments Less Their Deductions</field>
        <field name="code">CA_NPP</field>
        <field name="sequence">113</field>
        <field name="appears_on_payslip" eval="False" />
        <field name="company_id" eval="False" />
        <field name="amount_select">code</field>
        <field
            name="amount_python_compute"
        >result = l10n_ca.get(contract, categories.GROSS)["nonperiodic_net"]</field>
        <field
            name="note"
        >B - F3 of T4127, B2 of TP-1015.F: its year-to-date total is B1 of the bonus formulas.</field>
    </record>

    <!-- Employee deductions -->
    <record id="rule_cpp" model="hr.salary.rule">
        <field name="name">CPP/QPP Contributions</field>
        <field name="code">CA_CPP</field>
        <field name="sequence">120</field>
        <field name="category_id" ref="categ_ded" />
        <field name="register_id" ref="register_receiver_general" />
        <field name="company_id" eval="False" />
        <field name="amount_select">code</field>
        <field name="amount_python_compute">ca = l10n_ca.get(contract, categories.GROSS)
result = -ca["cpp"]
result_name = ca["line_names"]["CA_CPP"]</field>
    </record>
    <record id="rule_cpp2" model="hr.salary.rule">
        <field name="name">CPP2/QPP2 Contributions</field>
        <field name="code">CA_CPP2</field>
        <field name="sequence">121</field>
        <field name="category_id" ref="categ_ded" />
        <field name="register_id" ref="register_receiver_general" />
        <field name="company_id" eval="False" />
        <field name="amount_select">code</field>
        <field name="amount_python_compute">ca = l10n_ca.get(contract, categories.GROSS)
result = -ca["cpp2"]
result_name = ca["line_names"]["CA_CPP2"]</field>
    </record>
    <record id="rule_f5b" model="hr.salary.rule">
        <field name="name">Additional CPP/QPP Contributions on Non-Periodic Payments</field>
        <field name="code">CA_F5B</field>
        <field name="sequence">122</field>
        <field name="appears_on_payslip" eval="False" />
        <field name="company_id" eval="False" />
        <field name="amount_select">code</field>
        <field
            name="amount_python_compute"
        >result = l10n_ca.get(contract, categories.GROSS)["f5b"]</field>
        <field
            name="note"
        >F5B of T4127, CSB of TP-1015.F: the first and second additional contributions of the period times B / PI. Its year-to-date total is F5BYTD and CSB1.</field>
    </record>
    <record id="rule_ei" model="hr.salary.rule">
        <field name="name">EI Premiums</field>
        <field name="code">CA_EI</field>
        <field name="sequence">130</field>
        <field name="category_id" ref="categ_ded" />
        <field name="register_id" ref="register_receiver_general" />
        <field name="company_id" eval="False" />
        <field name="amount_select">code</field>
        <field
            name="amount_python_compute"
        >result = -l10n_ca.get(contract, categories.GROSS)["ei"]</field>
    </record>
    <record id="rule_federal_tax" model="hr.salary.rule">
        <field name="name">Federal Income Tax</field>
        <field name="code">CA_FIT</field>
        <field name="sequence">140</field>
        <field name="category_id" ref="categ_ded" />
        <field name="register_id" ref="register_receiver_general" />
        <field name="company_id" eval="False" />
        <field name="amount_select">code</field>
        <field
            name="amount_python_compute"
        >result = -l10n_ca.get(contract, categories.GROSS)["federal_tax"]</field>
    </record>
    <record id="rule_provincial_tax" model="hr.salary.rule">
        <field name="name">Provincial Income Tax</field>
        <field name="code">CA_PIT</field>
        <field name="sequence">150</field>
        <field name="category_id" ref="categ_ded" />
        <field name="company_id" eval="False" />
        <field name="amount_select">code</field>
        <field name="amount_python_compute">ca = l10n_ca.get(contract, categories.GROSS)
result = -ca["provincial_tax"]
result_name = ca["provincial_tax_label"]</field>
        <field
            name="note"
        >Computed by the module of the province. Without one, the line shows a warning and a zero amount.</field>
    </record>

    <!-- Net -->
    <record id="rule_net" model="hr.salary.rule">
        <field name="name">Net Salary</field>
        <field name="code">NET</field>
        <field name="sequence">200</field>
        <field name="category_id" ref="categ_net" />
        <field name="company_id" eval="False" />
        <field name="amount_select">code</field>
        <field name="amount_python_compute">result = categories.GROSS + categories.DED</field>
    </record>

    <!-- Employer contributions -->
    <record id="rule_cpp_employer" model="hr.salary.rule">
        <field name="name">CPP/QPP Employer Contributions</field>
        <field name="code">CA_CPP_ER</field>
        <field name="sequence">300</field>
        <field name="category_id" ref="categ_comp" />
        <field name="register_id" ref="register_receiver_general" />
        <field name="company_id" eval="False" />
        <field name="amount_select">code</field>
        <field name="amount_python_compute">ca = l10n_ca.get(contract, categories.GROSS)
result = ca["cpp_employer"]
result_name = ca["line_names"]["CA_CPP_ER"]</field>
    </record>
    <record id="rule_cpp2_employer" model="hr.salary.rule">
        <field name="name">CPP2/QPP2 Employer Contributions</field>
        <field name="code">CA_CPP2_ER</field>
        <field name="sequence">301</field>
        <field name="category_id" ref="categ_comp" />
        <field name="register_id" ref="register_receiver_general" />
        <field name="company_id" eval="False" />
        <field name="amount_select">code</field>
        <field name="amount_python_compute">ca = l10n_ca.get(contract, categories.GROSS)
result = ca["cpp2_employer"]
result_name = ca["line_names"]["CA_CPP2_ER"]</field>
    </record>
    <record id="rule_ei_employer" model="hr.salary.rule">
        <field name="name">EI Employer Premiums</field>
        <field name="code">CA_EI_ER</field>
        <field name="sequence">310</field>
        <field name="category_id" ref="categ_comp" />
        <field name="register_id" ref="register_receiver_general" />
        <field name="company_id" eval="False" />
        <field name="amount_select">code</field>
        <field
            name="amount_python_compute"
        >result = l10n_ca.get(contract, categories.GROSS)["ei_employer"]</field>
    </record>

    <!-- Structure -->
    <record id="structure_ca_base" model="hr.payroll.structure">
        <field name="name">Canada - Base</field>
        <field name="code">CA_BASE</field>
        <field name="parent_id" eval="False" />
        <field name="company_id" ref="base.main_company" />
        <field
            name="rule_ids"
            eval="[(6, 0, [
                ref('rule_basic'),
                ref('rule_bonus'),
                ref('rule_rpp'),
                ref('rule_rrsp'),
                ref('rule_union'),
                ref('rule_support'),
                ref('rule_lsvcc'),
                ref('rule_gross'),
                ref('rule_pensionable'),
                ref('rule_insurable'),
                ref('rule_nonperiodic'),
                ref('rule_cpp'),
                ref('rule_cpp2'),
                ref('rule_f5b'),
                ref('rule_ei'),
                ref('rule_federal_tax'),
                ref('rule_provincial_tax'),
                ref('rule_net'),
                ref('rule_cpp_employer'),
                ref('rule_cpp2_employer'),
                ref('rule_ei_employer'),
            ])]"
        />
        <field
            name="note"
        >Canadian federal payroll: CPP/QPP, CPP2/QPP2, EI and federal income tax per the CRA payroll deductions formulas (T4127). Provincial income tax comes from the module of each province.</field>
    </record>
</odoo>
