<odoo>
    <record id="l10n_ca_payroll_source_view_list" model="ir.ui.view">
        <field name="name">l10n_ca.payroll.source.list</field>
        <field name="model">l10n_ca.payroll.source</field>
        <field name="arch" type="xml">
            <list decoration-warning="state == 'to_verify'">
                <field name="sequence" widget="handle" />
                <field name="jurisdiction" />
                <field name="name" />
                <field name="reference" optional="show" />
                <field name="publisher" optional="show" />
                <field name="kind" optional="hide" />
                <field name="url" widget="url" />
                <field name="parameter_count" optional="show" />
                <field name="state" />
                <field name="verified_date" optional="hide" />
            </list>
        </field>
    </record>
    <record id="l10n_ca_payroll_source_view_form" model="ir.ui.view">
        <field name="name">l10n_ca.payroll.source.form</field>
        <field name="model">l10n_ca.payroll.source</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" options="{'clickable': '1'}" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="jurisdiction" />
                            <field name="kind" />
                            <field name="publisher" />
                            <field name="reference" />
                        </group>
                        <group>
                            <field name="url" widget="url" />
                            <field name="verified_date" />
                            <field name="sequence" />
                        </group>
                    </group>
                    <group string="What the payroll takes from it">
                        <field name="summary" nolabel="1" colspan="2" />
                    </group>
                    <group
                        string="To confirm in a browser"
                        invisible="state != 'to_verify' and not verification_note"
                    >
                        <field name="verification_note" nolabel="1" colspan="2" />
                    </group>
                    <group string="Time parameters citing this source">
                        <field name="parameter_ids" nolabel="1" colspan="2">
                            <list>
                                <field name="code" />
                                <field name="name" />
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="l10n_ca_payroll_source_view_search" model="ir.ui.view">
        <field name="name">l10n_ca.payroll.source.search</field>
        <field name="model">l10n_ca.payroll.source</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="reference" />
                <field name="url" />
                <filter
                    name="to_verify"
                    string="To Verify"
                    domain="[('state', '=', 'to_verify')]"
                />
                <separator />
                <filter
                    name="federal"
                    string="Federal"
                    domain="[('jurisdiction', '=', 'federal')]"
                />
                <filter
                    name="quebec"
                    string="Quebec"
                    domain="[('jurisdiction', '=', 'quebec')]"
                />
                <filter
                    name="ontario"
                    string="Ontario"
                    domain="[('jurisdiction', '=', 'ontario')]"
                />
                <group>
                    <filter
                        name="group_jurisdiction"
                        string="Jurisdiction"
                        context="{'group_by': 'jurisdiction'}"
                    />
                    <filter
                        name="group_state"
                        string="Verification"
                        context="{'group_by': 'state'}"
                    />
                </group>
            </search>
        </field>
    </record>
    <record id="action_l10n_ca_payroll_source" model="ir.actions.act_window">
        <field name="name">Canadian Official Sources</field>
        <field name="res_model">l10n_ca.payroll.source</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_jurisdiction': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No official source
            </p>
            <p>
                The payroll modules list here the publications, pages and
                statutes their rates, ceilings and due dates come from.
            </p>
        </field>
    </record>
</odoo>
