<odoo>
    <record id="hr_contract_view_form" model="ir.ui.view">
        <field name="name">hr.contract.form.l10n_ca_payroll</field>
        <field name="model">hr.contract</field>
        <field name="inherit_id" ref="hr_contract.hr_contract_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Canadian Payroll" name="l10n_ca_payroll">
                    <group>
                        <group name="l10n_ca_employment" string="Employment">
                            <field name="l10n_ca_province_id" />
                            <field name="l10n_ca_pay_periods" />
                            <field name="l10n_ca_cpp_exempt" />
                            <field name="l10n_ca_ei_exempt" />
                            <field name="l10n_ca_t4_dental_code" />
                            <field
                                name="l10n_ca_wcb_exempt"
                                invisible="not l10n_ca_prov_computed"
                            />
                        </group>
                        <group name="l10n_ca_td1_federal" string="Federal TD1">
                            <field name="l10n_ca_td1_federal_type" />
                            <field
                                name="l10n_ca_td1_federal_bpa"
                                invisible="l10n_ca_td1_federal_type != 'basic'"
                            />
                            <field
                                name="l10n_ca_td1_federal_amount"
                                invisible="l10n_ca_td1_federal_type != 'custom'"
                            />
                            <field name="l10n_ca_additional_federal_tax" />
                            <field name="l10n_ca_federal_other_credits" />
                        </group>
                        <field name="l10n_ca_prov_computed" invisible="1" />
                        <field name="l10n_ca_province_code" invisible="1" />
                        <group
                            name="l10n_ca_td1_provincial"
                            string="Provincial TD1"
                            invisible="not l10n_ca_prov_computed"
                        >
                            <field name="l10n_ca_prov_td1_type" />
                            <field
                                name="l10n_ca_prov_bpa"
                                invisible="l10n_ca_prov_td1_type != 'basic'"
                            />
                            <field
                                name="l10n_ca_prov_td1_amount"
                                invisible="l10n_ca_prov_td1_type != 'custom'"
                            />
                            <field name="l10n_ca_prov_other_credits" />
                            <field name="l10n_ca_prov_additional_tax" />
                        </group>
                        <group
                            name="l10n_ca_tax_deductions"
                            string="Retirement Savings Withheld"
                        >
                            <field name="l10n_ca_rpp_amount" />
                            <field name="l10n_ca_rrsp_amount" />
                        </group>
                        <group
                            name="l10n_ca_other_deductions"
                            string="Other Deductions Withheld"
                        >
                            <field name="l10n_ca_union_dues_amount" />
                            <field name="l10n_ca_union_issues_receipts" />
                            <field name="l10n_ca_support_amount" />
                            <field name="l10n_ca_lsvcc_amount" />
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
