<odoo>
    <record id="l10n_ca_payroll_t4_slip_view_list" model="ir.ui.view">
        <field name="name">l10n_ca.payroll.t4.slip.list</field>
        <field name="model">l10n_ca.payroll.t4.slip</field>
        <field name="arch" type="xml">
            <list create="false">
                <field name="currency_id" column_invisible="True" />
                <field name="employee_id" />
                <field name="province_code" />
                <field name="box_14" sum="Total" />
                <field name="box_16" sum="Total" />
                <field name="box_16a" sum="Total" optional="show" />
                <field name="box_17" sum="Total" optional="hide" />
                <field name="box_17a" sum="Total" optional="hide" />
                <field name="box_18" sum="Total" />
                <field name="box_22" sum="Total" />
                <field name="box_24" optional="show" />
                <field name="box_26" optional="show" />
                <field name="box_44" optional="hide" />
            </list>
        </field>
    </record>
    <record id="l10n_ca_payroll_t4_slip_view_form" model="ir.ui.view">
        <field name="name">l10n_ca.payroll.t4.slip.form</field>
        <field name="model">l10n_ca.payroll.t4.slip</field>
        <field name="arch" type="xml">
            <form create="false">
                <sheet>
                    <group>
                        <group string="Employee">
                            <field name="currency_id" invisible="1" />
                            <field name="employee_id" readonly="1" />
                            <field name="sin" />
                            <field name="province_code" />
                            <field name="year" />
                            <field name="cpp_exempt" />
                            <field name="ei_exempt" />
                        </group>
                        <group string="Boxes">
                            <field name="box_14" />
                            <field name="box_16" />
                            <field name="box_16a" />
                            <field name="box_17" />
                            <field name="box_17a" />
                            <field name="box_18" />
                            <field name="box_22" />
                            <field name="box_24" />
                            <field name="box_26" />
                            <field name="box_44" />
                            <field name="box_45" />
                        </group>
                        <group string="Employer Share">
                            <field name="employer_cpp" />
                            <field name="employer_cpp2" />
                            <field name="employer_ei" />
                        </group>
                    </group>
                    <field name="payslip_ids" readonly="1" />
                </sheet>
            </form>
        </field>
    </record>
    <record id="l10n_ca_payroll_t4_summary_view_list" model="ir.ui.view">
        <field name="name">l10n_ca.payroll.t4.summary.list</field>
        <field name="model">l10n_ca.payroll.t4.summary</field>
        <field name="arch" type="xml">
            <list>
                <field name="currency_id" column_invisible="True" />
                <field name="name" />
                <field name="company_id" groups="base.group_multi_company" />
                <field name="due_date" />
                <field name="line_14" />
                <field name="line_80" />
                <field name="line_82" />
                <field name="line_86" />
                <field name="line_88" />
            </list>
        </field>
    </record>
    <record id="l10n_ca_payroll_t4_summary_view_form" model="ir.ui.view">
        <field name="name">l10n_ca.payroll.t4.summary.form</field>
        <field name="model">l10n_ca.payroll.t4.summary</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_compute_slips"
                        type="object"
                        string="Compute T4 Slips"
                        class="btn-primary"
                    />
                    <button
                        name="action_compute_remittances"
                        type="object"
                        string="Compute Remittances"
                    />
                    <button
                        name="action_export_t4_csv"
                        type="object"
                        string="Export T4 (CSV)"
                        invisible="not slip_ids"
                    />
                    <button
                        name="action_export_pd7a_csv"
                        type="object"
                        string="Export PD7A (CSV)"
                        invisible="not remittance_ids"
                    />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="year" options="{'format': false}" />
                            <field name="company_id" />
                            <field name="currency_id" invisible="1" />
                            <field name="due_date" />
                            <field name="csv_filename" invisible="1" />
                        </group>
                        <group string="T4 Summary">
                            <field name="line_14" />
                            <field name="line_16" />
                            <field name="line_16a" />
                            <field name="line_27" />
                            <field name="line_27a" />
                            <field name="line_18" />
                            <field name="line_19" />
                            <field name="line_22" />
                            <field name="line_80" />
                            <field name="line_82" />
                            <field name="line_84" />
                            <field name="line_86" />
                            <field name="line_88" />
                        </group>
                    </group>
                    <notebook>
                        <page string="T4 Slips" name="slips">
                            <field name="slip_ids" />
                        </page>
                        <page string="Remittances (PD7A)" name="remittances">
                            <field name="remittance_ids" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_l10n_ca_payroll_t4_summary" model="ir.actions.act_window">
        <field name="name">T4 Year-End</field>
        <field name="res_model">l10n_ca.payroll.t4.summary</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create the year-end summary of a calendar year.
            </p>
            <p>
                The T4 slips and the remittances are computed from the done
                payslips whose pay date falls in the year, and can be
                exported as CSV files to fill in the CRA web forms.
            </p>
        </field>
    </record>
</odoo>
