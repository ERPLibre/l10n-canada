<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.l10n_ca_payroll</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="payroll.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//app[@name='payroll']" position="inside">
                <block title="Canadian Payroll" name="l10n_ca_payroll">
                    <setting
                        string="CRA Payroll Account"
                        help="Payroll program account and remitter type"
                    >
                        <div class="content-group">
                            <div class="row mt8">
                                <label
                                    for="l10n_ca_payroll_account_number"
                                    class="col-lg-5 o_light_label"
                                />
                                <field name="l10n_ca_payroll_account_number" />
                            </div>
                            <div class="row mt8">
                                <label
                                    for="l10n_ca_payroll_remitter_type"
                                    class="col-lg-5 o_light_label"
                                />
                                <field name="l10n_ca_payroll_remitter_type" />
                            </div>
                        </div>
                    </setting>
                    <setting
                        string="EI Premium Reduction"
                        help="Reduced employer multiplier assigned by the Premium Reduction Program; 0 uses the legal multiplier"
                    >
                        <field name="l10n_ca_ei_employer_multiplier" />
                    </setting>
                    <setting
                        string="Salary Structure and Accounts"
                        help="Set the Canada - Base structure as default and propose the accounts of the Canadian chart on its rules"
                    >
                        <button
                            name="action_l10n_ca_payroll_setup"
                            type="object"
                            string="Set Up Canadian Payroll"
                            class="btn-link"
                            icon="oi-arrow-right"
                        />
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
