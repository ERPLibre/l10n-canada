<odoo>
    <record id="l10n_ca_payroll_remittance_view_list" model="ir.ui.view">
        <field name="name">l10n_ca.payroll.remittance.list</field>
        <field name="model">l10n_ca.payroll.remittance</field>
        <field name="arch" type="xml">
            <list editable="bottom" create="false">
                <field name="company_id" column_invisible="True" />
                <field name="currency_id" column_invisible="True" />
                <field name="date_from" readonly="1" />
                <field name="date_to" readonly="1" />
                <field name="due_date" readonly="1" />
                <field name="employee_count" readonly="1" optional="show" />
                <field name="gross_payroll" readonly="1" sum="Total" />
                <field name="cpp_employee" readonly="1" sum="Total" optional="show" />
                <field name="cpp_employer" readonly="1" sum="Total" optional="show" />
                <field name="cpp2_employee" readonly="1" sum="Total" optional="hide" />
                <field name="cpp2_employer" readonly="1" sum="Total" optional="hide" />
                <field name="ei_employee" readonly="1" sum="Total" optional="show" />
                <field name="ei_employer" readonly="1" sum="Total" optional="show" />
                <field name="income_tax" readonly="1" sum="Total" />
                <field name="total" sum="Total" />
                <field name="amount_paid" sum="Total" />
                <field name="payment_date" />
            </list>
        </field>
    </record>
    <record id="l10n_ca_payroll_remittance_view_form" model="ir.ui.view">
        <field name="name">l10n_ca.payroll.remittance.form</field>
        <field name="model">l10n_ca.payroll.remittance</field>
        <field name="arch" type="xml">
            <form create="false">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <group>
                        <group string="Period">
                            <field name="company_id" readonly="1" />
                            <field name="currency_id" invisible="1" />
                            <field name="remitter_type" />
                            <field name="date_from" readonly="1" />
                            <field name="date_to" readonly="1" />
                            <field name="due_date" readonly="1" />
                            <field name="payslip_count" readonly="1" />
                            <field name="employee_count" readonly="1" />
                            <field name="gross_payroll" readonly="1" />
                        </group>
                        <group string="Source Deductions">
                            <field name="cpp_employee" readonly="1" />
                            <field name="cpp_employer" readonly="1" />
                            <field name="cpp2_employee" readonly="1" />
                            <field name="cpp2_employer" readonly="1" />
                            <field name="ei_employee" readonly="1" />
                            <field name="ei_employer" readonly="1" />
                            <field name="income_tax" readonly="1" />
                            <field name="total" />
                            <field name="amount_paid" />
                            <field name="payment_date" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="l10n_ca_payroll_remittance_view_search" model="ir.ui.view">
        <field name="name">l10n_ca.payroll.remittance.search</field>
        <field name="model">l10n_ca.payroll.remittance</field>
        <field name="arch" type="xml">
            <search>
                <field name="date_from" />
                <filter
                    name="unpaid"
                    string="Not Paid"
                    domain="[('payment_date', '=', False)]"
                />
                <group>
                    <filter
                        name="group_year"
                        string="Year"
                        context="{'group_by': 'date_from:year'}"
                    />
                </group>
            </search>
        </field>
    </record>
    <record id="action_l10n_ca_payroll_remittance" model="ir.actions.act_window">
        <field name="name">Source Deduction Remittances (PD7A)</field>
        <field name="res_model">l10n_ca.payroll.remittance</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No remittance yet.</p>
            <p>
                Open the year-end summary of the year and click "Compute
                Remittances": one remittance is created per period of the
                remitter type of the company, from the done payslips.
            </p>
        </field>
    </record>
</odoo>
