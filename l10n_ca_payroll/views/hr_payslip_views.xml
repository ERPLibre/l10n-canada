<odoo>
    <record id="hr_payslip_view_form" model="ir.ui.view">
        <field name="name">hr.payslip.form.l10n_ca_payroll</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="payroll.hr_payslip_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//sheet/div[hasclass('oe_title')]" position="before">
                <div
                    class="alert alert-warning"
                    role="alert"
                    invisible="not l10n_ca_warning"
                >
                    <field name="l10n_ca_warning" />
                </div>
            </xpath>
            <xpath expr="//group[@name='right']" position="inside">
                <field name="l10n_ca_pay_date" />
                <field name="l10n_ca_province_id" />
                <field name="l10n_ca_pension_plan" />
            </xpath>
        </field>
    </record>
    <record id="hr_payslip_view_search" model="ir.ui.view">
        <field name="name">hr.payslip.search.l10n_ca_payroll</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="payroll.hr_payslip_view_search" />
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <filter
                    name="l10n_ca_warning"
                    string="Canadian Payroll Warnings"
                    domain="[('l10n_ca_warning', '!=', False)]"
                />
            </xpath>
        </field>
    </record>
</odoo>
