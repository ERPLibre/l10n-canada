    <record id="source_wscb_policy_5_4" model="l10n_ca.payroll.source">
        <field name="sequence">90</field>
        <field name="jurisdiction">yukon</field>
        <field name="kind">publication</field>
        <field
            name="name"
        >Policy 5.4 Reporting Payroll and Payment of Assessment Premiums</field>
        <field
            name="publisher"
        >Workers' Safety and Compensation Board (Yukon)</field>
        <field name="reference">In effect since July 1, 2022</field>
        <field
            name="url"
        >https://www.wcb.yk.ca/policies/employer-assessments/5-4-reporting-payroll-and-payment-of-assessment-pr</field>
        <field
            name="summary"
        >Premium = assessable payroll, capped per worker at the maximum annual earnings, x the rate per $100; minimum premium 150. Annual payroll report (actual payroll of the previous year, estimate of the current one) due by the last day of February; premiums due January 1 and payable within 30 days of the invoice; instalments on request above 500; monthly reporting and payment by the 15th of the following month under the actual payroll method.</field>
        <field name="verified_date">2026-11-12</field>
    </record>
