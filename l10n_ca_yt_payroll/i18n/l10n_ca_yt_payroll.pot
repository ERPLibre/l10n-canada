msgstr ""

#. module: l10n_ca_yt_payroll
#: model:l10n_ca.payroll.source,summary:l10n_ca_yt_payroll.source_wscb_maximum
msgid ""
"Maximum annual earnings per worker on which the employer pays assessment "
"premiums: 104,975 in 2025, 107,599 in 2026, 111,580 in 2027. All earnings in"
" Yukon are reported; none above the maximum is assessed."
msgstr ""

