#. module: l10n_ca_nl_payroll
#: model:l10n_ca.payroll.source,summary:l10n_ca_nl_payroll.source_workplacenl_annual_assessment
msgid ""
"Maximum assessable earnings per worker, adjusted each year by the consumer "
"price index: 79,345 in 2025, 80,935 in 2026, 82,800 in 2027. Assessment = "
"rate per $100 x assessable payroll; Employer Payroll Statement due February "
"28; excess earnings above the maximum deducted per worker; minimum annual "
"assessment of 50."
msgstr ""

#. module: l10n_ca_nl_payroll
#: model:l10n_ca.payroll.source,summary:l10n_ca_nl_payroll.source_workplacenl_2026
msgid ""
"Maximum compensable and assessable earnings of 80,935 for 2026 (79,345 in "
"2025); average assessment rate 1.73 per $100."
msgstr ""

#. module: l10n_ca_nl_payroll
#: model:l10n_ca.payroll.source,summary:l10n_ca_nl_payroll.source_workplacenl_2027
msgid ""
"Maximum compensable and assessable earnings of 82,800 from January 1, 2027 "
"(80,935 in 2026); average assessment rate 1.66 per $100 in 2027."
msgstr ""

#. module: l10n_ca_nl_payroll
#: model:l10n_ca.payroll.source,summary:l10n_ca_nl_payroll.source_revenue_administration_regulations
