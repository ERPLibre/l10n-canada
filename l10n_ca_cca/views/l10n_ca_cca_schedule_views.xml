<odoo>
    <record id="l10n_ca_cca_schedule_view_list" model="ir.ui.view">
        <field name="name">l10n.ca.cca.schedule.list</field>
        <field name="model">l10n.ca.cca.schedule</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="date_from" />
                <field name="date_to" />
                <field name="jurisdiction" />
                <field name="company_id" groups="base.group_multi_company" />
                <field name="currency_id" column_invisible="1" />
                <field name="total_cca" sum="Total" />
                <field name="total_recapture" sum="Total" />
                <field name="total_terminal_loss" sum="Total" />
                <field name="total_closing_ucc" />
                <field
                    name="state"
                    widget="badge"
                    decoration-success="state == 'locked'"
                    decoration-info="state == 'draft'"
                />
            </list>
        </field>
    </record>
    <record id="l10n_ca_cca_schedule_line_view_list" model="ir.ui.view">
        <field name="name">l10n.ca.cca.schedule.line.list</field>
        <field name="model">l10n.ca.cca.schedule.line</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="state" column_invisible="1" />
                <field name="currency_id" column_invisible="1" />
                <field name="class_id" readonly="state == 'locked'" />
                <field name="asset_id" optional="show" readonly="1" />
                <field name="rate" widget="percentage" readonly="state == 'locked'" />
                <field name="opening_ucc" readonly="state == 'locked'" />
                <field name="additions" sum="Total" />
                <field
                    name="adjustments"
                    optional="hide"
                    readonly="state == 'locked'"
                />
                <field
                    name="dispositions"
                    sum="Total"
                    readonly="state == 'locked'"
                />
                <field name="ucc_before_cca" optional="hide" />
                <field name="cca_base" optional="hide" />
                <field name="max_cca" sum="Total" />
                <field name="cca_claimed" sum="Total" readonly="state == 'locked'" />
                <field name="recapture" sum="Total" />
                <field name="terminal_loss" sum="Total" />
                <field name="closing_ucc" sum="Total" />
                <field name="book_depreciation" sum="Total" optional="show" />
                <field name="book_tax_difference" sum="Total" optional="show" />
                <field
                    name="property_remaining"
                    optional="show"
                    readonly="state == 'locked'"
                />
            </list>
        </field>
    </record>
    <record id="l10n_ca_cca_schedule_line_view_form" model="ir.ui.view">
        <field name="name">l10n.ca.cca.schedule.line.form</field>
        <field name="model">l10n.ca.cca.schedule.line</field>
        <field name="arch" type="xml">
            <form>
                <field name="state" invisible="1" />
                <field name="currency_id" invisible="1" />
                <field name="method" invisible="1" />
                <group>
                    <group string="Class">
                        <field name="class_id" readonly="state == 'locked'" />
                        <field name="asset_id" readonly="1" />
                        <field
                            name="rate"
                            widget="percentage"
                            readonly="state == 'locked'"
                        />
                        <field name="half_year_factor" readonly="state == 'locked'" />
                        <field name="proration" readonly="state == 'locked'" />
                        <field
                            name="property_remaining"
                            readonly="state == 'locked'"
                        />
                    </group>
                    <group string="Undepreciated Capital Cost">
                        <field name="opening_ucc" readonly="state == 'locked'" />
                        <field name="additions" />
                        <field name="adjustments" readonly="state == 'locked'" />
                        <field name="dispositions" readonly="state == 'locked'" />
                        <field name="ucc_before_cca" />
                    </group>
                    <group string="Additions of the Year">
                        <field
                            name="additions_regular"
                            readonly="state == 'locked'"
                        />
                        <field name="regular_factor" readonly="state == 'locked'" />
                        <field
                            name="additions_enhanced"
                            readonly="state == 'locked'"
                        />
                        <field name="enhanced_factor" readonly="state == 'locked'" />
                        <field
                            name="additions_expensing"
                            readonly="state == 'locked'"
                        />
                        <field name="expensing_rate" readonly="state == 'locked'" />
                        <field
                            name="straight_line_amount"
                            readonly="state == 'locked'"
                            invisible="method != 'straight_line'"
                        />
                    </group>
                    <group string="Allowance">
                        <field name="cca_base" />
                        <field name="max_cca" />
                        <field name="cca_claimed" readonly="state == 'locked'" />
                        <field name="recapture" />
                        <field name="terminal_loss" />
                        <field name="closing_ucc" />
                    </group>
                    <group string="Book">
                        <field name="book_depreciation" readonly="1" />
                        <field name="book_gain_loss" readonly="1" />
                        <field name="capital_gain" readonly="1" />
                        <field name="book_tax_difference" />
                    </group>
                </group>
            </form>
        </field>
    </record>
    <record id="l10n_ca_cca_schedule_view_form" model="ir.ui.view">
        <field name="name">l10n.ca.cca.schedule.form</field>
        <field name="model">l10n.ca.cca.schedule</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_generate"
                        string="Generate from Assets"
                        type="object"
                        class="oe_highlight"
                        invisible="state != 'draft'"
                    />
                    <button
                        name="action_claim_maximum"
                        string="Claim Maximum"
                        type="object"
                        invisible="state != 'draft'"
                    />
                    <button
                        name="action_lock"
                        string="Lock"
                        type="object"
                        invisible="state != 'draft'"
                    />
                    <button
                        name="action_unlock"
                        string="Unlock"
                        type="object"
                        invisible="state != 'locked'"
                        groups="account.group_account_manager"
                    />
                    <button name="action_print" string="Print" type="object" />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="jurisdiction" readonly="state == 'locked'" />
                            <field name="date_from" readonly="state == 'locked'" />
                            <field name="date_to" readonly="state == 'locked'" />
                        </group>
                        <group>
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                                readonly="state == 'locked'"
                            />
                            <field name="currency_id" invisible="1" />
                            <field name="previous_id" />
                            <field name="total_cca" />
                            <field name="total_closing_ucc" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Schedule 8" name="lines">
                            <field
                                name="line_ids"
                                readonly="state == 'locked'"
                                context="{'list_view_ref': 'l10n_ca_cca.l10n_ca_cca_schedule_line_view_list', 'form_view_ref': 'l10n_ca_cca.l10n_ca_cca_schedule_line_view_form'}"
                            />
                        </page>
                        <page string="Book to Tax Reconciliation" name="reconciliation">
                            <group>
                                <group string="Added to Net Income (Schedule 1)">
                                    <field
                                        name="total_book_depreciation"
                                        string="Amortization (line 104)"
                                    />
                                    <field
                                        name="total_recapture"
                                        string="Recapture of CCA (line 107)"
                                    />
                                    <field
                                        name="total_book_loss"
                                        string="Loss on disposal of assets (line 111)"
                                    />
                                </group>
                                <group string="Deducted from Net Income (Schedule 1)">
                                    <field
                                        name="total_book_gain"
                                        string="Gain on disposal of assets (line 401)"
                                    />
                                    <field
                                        name="total_cca"
                                        string="Capital cost allowance (line 403)"
                                    />
                                    <field
                                        name="total_terminal_loss"
                                        string="Terminal loss (line 404)"
                                    />
                                </group>
                                <group>
                                    <field name="schedule1_adjustment" />
                                    <field name="total_capital_gain" />
                                </group>
                            </group>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="l10n_ca_cca_schedule_view_search" model="ir.ui.view">
        <field name="name">l10n.ca.cca.schedule.search</field>
        <field name="model">l10n.ca.cca.schedule</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <filter
                    name="federal"
                    string="Federal"
                    domain="[('jurisdiction', '=', 'federal')]"
                />
                <filter
                    name="quebec"
                    string="Quebec"
                    domain="[('jurisdiction', '=', 'quebec')]"
                />
                <separator />
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]" />
                <filter
                    name="locked"
                    string="Locked"
                    domain="[('state', '=', 'locked')]"
                />
            </search>
        </field>
    </record>
    <record id="action_l10n_ca_cca_schedule" model="ir.actions.act_window">
        <field name="name">CCA Schedules</field>
        <field name="res_model">l10n.ca.cca.schedule</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create the capital cost allowance schedule of a taxation year.
            </p>
            <p>
                Generate it from the assets, adjust the CCA claimed, then lock
                it: the closing balances become the opening balances of the
                next year.
            </p>
        </field>
    </record>
</odoo>
