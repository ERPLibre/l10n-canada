<odoo>
    <record id="l10n_ca_cca_class_view_list" model="ir.ui.view">
        <field name="name">l10n.ca.cca.class.list</field>
        <field name="model">l10n.ca.cca.class</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle" />
                <field name="number" />
                <field name="name" />
                <field name="method" />
                <field name="current_rate" widget="percentage" />
                <field name="half_year_rule" />
                <field name="aiip_eligible" />
                <field name="immediate_expensing_eligible" />
                <field name="separate_class" optional="hide" />
            </list>
        </field>
    </record>
    <record id="l10n_ca_cca_class_view_form" model="ir.ui.view">
        <field name="name">l10n.ca.cca.class.form</field>
        <field name="model">l10n.ca.cca.class</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="bg-danger"
                        invisible="active"
                    />
                    <div class="oe_title">
                        <h1>
                            <field name="number" class="oe_inline" />
                            -
                            <field name="name" class="oe_inline" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="method" />
                            <field name="current_rate" widget="percentage" />
                            <field name="param_prefix" />
                            <field name="active" invisible="1" />
                        </group>
                        <group>
                            <field name="half_year_rule" />
                            <field name="aiip_eligible" />
                            <field name="immediate_expensing_eligible" />
                            <field name="separate_class" />
                            <field name="no_recapture_terminal_loss" />
                        </group>
                    </group>
                    <group string="Content">
                        <field name="note" nolabel="1" colspan="2" />
                    </group>
                    <group string="Quebec Differences">
                        <field name="quebec_note" nolabel="1" colspan="2" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="l10n_ca_cca_class_view_search" model="ir.ui.view">
        <field name="name">l10n.ca.cca.class.search</field>
        <field name="model">l10n.ca.cca.class</field>
        <field name="arch" type="xml">
            <search>
                <field name="number" />
                <field name="name" />
                <filter
                    name="archived"
                    string="Archived"
                    domain="[('active', '=', False)]"
                />
            </search>
        </field>
    </record>
    <record id="action_l10n_ca_cca_class" model="ir.actions.act_window">
        <field name="name">CCA Classes</field>
        <field name="res_model">l10n.ca.cca.class</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No CCA class yet.</p>
            <p>
                Classes of depreciable property. Their rates, limits and
                incentive windows are dated parameters under Accounting
                &gt; Configuration &gt; Canadian Time Parameters.
            </p>
        </field>
    </record>
</odoo>
