<odoo>
    <record id="l10n_ca_gifi_statement_view_list" model="ir.ui.view">
        <field name="name">l10n.ca.gifi.statement.list</field>
        <field name="model">l10n.ca.gifi.statement</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="date_from" />
                <field name="date_to" />
                <field name="company_id" groups="base.group_multi_company" />
                <field name="total_assets" />
                <field name="net_income" />
                <field name="error_count" />
                <field name="warning_count" optional="show" />
                <field name="computed_on" optional="hide" />
            </list>
        </field>
    </record>

    <record id="l10n_ca_gifi_statement_line_view_list" model="ir.ui.view">
        <field name="name">l10n.ca.gifi.statement.line.list</field>
        <field name="model">l10n.ca.gifi.statement.line</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" decoration-bf="is_total">
                <field name="code" />
                <field name="name" />
                <field name="amount" />
                <field name="amount_exact" optional="hide" />
                <field name="account_ids" widget="many2many_tags" optional="show" />
                <field name="is_total" column_invisible="True" />
            </list>
        </field>
    </record>

    <record id="l10n_ca_gifi_statement_view_form" model="ir.ui.view">
        <field name="name">l10n.ca.gifi.statement.form</field>
        <field name="model">l10n.ca.gifi.statement</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_compute"
                        type="object"
                        string="Compute"
                        class="btn-primary"
                    />
                    <button
                        name="action_export_csv"
                        type="object"
                        string="CSV Schedule 100"
                        context="{'gifi_schedule': '100'}"
                        invisible="not computed_on"
                    />
                    <button
                        name="action_export_csv"
                        type="object"
                        string="CSV Schedule 101"
                        context="{'gifi_schedule': '101'}"
                        invisible="not computed_on or not first_year"
                    />
                    <button
                        name="action_export_csv"
                        type="object"
                        string="CSV Schedule 125"
                        context="{'gifi_schedule': '125'}"
                        invisible="not computed_on"
                    />
                    <button
                        name="action_print_xlsx"
                        type="object"
                        string="XLSX"
                        invisible="not computed_on"
                    />
                    <button
                        name="action_print_pdf"
                        type="object"
                        string="PDF"
                        invisible="not computed_on"
                    />
                </header>
                <sheet>
                    <div
                        class="alert alert-danger"
                        role="alert"
                        invisible="not error_count"
                    >
                        <field name="error_count" class="oe_inline" /> error(s) to
                        correct before filing: see the Checks tab.
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company" />
                            <field name="date_range_id" />
                            <field name="date_from" />
                            <field name="date_to" />
                            <field name="first_year" />
                        </group>
                        <group>
                            <field name="total_assets" />
                            <field name="net_income" />
                            <field name="warning_count" />
                            <field name="computed_on" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Schedule 100" name="s100">
                            <field name="s100_line_ids" />
                        </page>
                        <page string="Schedule 101" name="s101" invisible="not first_year">
                            <field name="s101_line_ids" />
                        </page>
                        <page string="Schedule 125" name="s125">
                            <field name="s125_line_ids" />
                        </page>
                        <page string="Checks" name="checks">
                            <field name="check_ids">
                                <list
                                    create="0"
                                    edit="0"
                                    delete="0"
                                    decoration-danger="level == 'error'"
                                    decoration-warning="level == 'warning'"
                                    decoration-muted="level == 'info'"
                                >
                                    <field name="level" />
                                    <field name="message" />
                                    <field name="gifi_code_id" optional="show" />
                                    <field name="account_id" optional="show" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="l10n_ca_gifi_statement_view_search" model="ir.ui.view">
        <field name="name">l10n.ca.gifi.statement.search</field>
        <field name="model">l10n.ca.gifi.statement</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="company_id" groups="base.group_multi_company" />
                <filter
                    string="With Errors"
                    name="with_errors"
                    domain="[('check_ids.level', '=', 'error')]"
                />
            </search>
        </field>
    </record>

    <record id="action_l10n_ca_gifi_statement" model="ir.actions.act_window">
        <field name="name">GIFI Statements</field>
        <field name="res_model">l10n.ca.gifi.statement</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a GIFI statement.</p>
            <p>
                A GIFI statement turns the posted entries of a fiscal year
                into the General Index of Financial Information: Schedule 100
                (balance sheet and retained earnings), Schedule 125 (income
                statement) and, for the first year, Schedule 101 (opening
                balance sheet), with the CRA consistency checks. Export each
                schedule as CSV for the T2 and CO-17 software, or print it.
            </p>
        </field>
    </record>
</odoo>
