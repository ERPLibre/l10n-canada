<odoo>
    <record id="view_account_form" model="ir.ui.view">
        <field name="name">account.account.form.l10n_ca_gifi</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account.view_account_form" />
        <field name="arch" type="xml">
            <field name="tag_ids" position="after">
                <field name="l10n_ca_gifi_code_id" options="{'no_create': True}" />
                <field
                    name="l10n_ca_gifi_effective_code_id"
                    string="GIFI Code (fallback)"
                    invisible="l10n_ca_gifi_code_id or not l10n_ca_gifi_effective_code_id"
                />
            </field>
        </field>
    </record>
    <record id="view_account_list" model="ir.ui.view">
        <field name="name">account.account.list.l10n_ca_gifi</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account.view_account_list" />
        <field name="arch" type="xml">
            <field name="account_type" position="after">
                <field
                    name="l10n_ca_gifi_code_id"
                    optional="show"
                    options="{'no_create': True}"
                />
                <field name="l10n_ca_gifi_mapping" optional="hide" />
            </field>
        </field>
    </record>
    <record id="view_account_search" model="ir.ui.view">
        <field name="name">account.account.search.l10n_ca_gifi</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account.view_account_search" />
        <field name="arch" type="xml">
            <filter name="activeacc" position="after">
                <separator />
                <filter
                    string="Without GIFI Code"
                    name="l10n_ca_gifi_unmapped"
                    domain="[('l10n_ca_gifi_mapping', 'in', ('type', 'none'))]"
                />
                <filter
                    string="Unmapped (no GIFI code nor fallback)"
                    name="l10n_ca_gifi_none"
                    domain="[('l10n_ca_gifi_mapping', '=', 'none')]"
                />
            </filter>
            <field name="name" position="after">
                <field name="l10n_ca_gifi_code_id" />
            </field>
        </field>
    </record>
    <record id="action_l10n_ca_gifi_unmapped_accounts" model="ir.actions.act_window">
        <field name="name">Accounts without GIFI Code</field>
        <field name="res_model">account.account</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_l10n_ca_gifi_unmapped': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Every account has a GIFI code.</p>
            <p>
                Accounts listed here are reported under the GIFI code of
                their account type, or not reported at all when the type
                has no code. Set a GIFI code on each of them.
            </p>
        </field>
    </record>
</odoo>
