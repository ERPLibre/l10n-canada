<odoo noupdate="1">
    <!-- GIFI code of an account without its own code, by account type.
         Each one is the generic lead item of the matching GIFI block; a
         cost of revenue account goes to 8450 Other direct costs rather
         than 8320 Purchases, which is reserved to goods and materials. -->
    <record id="type_map_asset_receivable" model="l10n.ca.gifi.account.type.map">
        <field name="account_type">asset_receivable</field>
        <field name="gifi_code_id" ref="gifi_1060" />
    </record>
